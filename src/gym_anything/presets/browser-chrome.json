{
  "id": "preset.browser-chrome@1",
  "version": "1.0",
  "description": "Chromium browser with Xvfb + VNC",
  "dockerfile": "gym_anything/presets/browser_chrome/Dockerfile",
  "entrypoint": "/workspace/start_browser.sh",
  "resources": {"cpu": 2, "mem_gb": 4, "gpu": 0, "net": true},
  "observation": [
    {"type": "rgb_screen", "fps": 10, "resolution": [1366, 768]},
    {"type": "audio_waveform", "sample_rate": 16000, "channels": 1, "chunk_duration_ms": 200}
  ],
  "action": [
    {"type": "mouse"},
    {"type": "keyboard"},
    {"type": "api_call"}
  ],
  "recording": {"enable": true, "output_dir": "./artifacts"},
  "vnc": {"enable": true, "host_port": 5930, "view_only": true},
  "security": {"user": "root", "cap_drop": ["ALL"]},
  "tags": ["browser", "web", "vision", "audio"]
}

