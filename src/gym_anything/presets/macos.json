{
  "id": "preset.macos@1",
  "version": "1.0",
  "description": "Remote macOS sandbox (use.computer M4 fleet). Targets the use_computer runner; envs pick the base image via spec.image ('base-macos' or 'base-human').",
  "os_type": "macos",
  "runner": "use_computer",
  "image": "base-macos",
  "resources": {
    "cpu": 4,
    "mem_gb": 8,
    "gpu": 0,
    "net": true
  },
  "observation": [
    {"type": "rgb_screen", "fps": 10, "resolution": [1920, 1080], "inline": false}
  ],
  "action": [
    {"type": "mouse"},
    {"type": "keyboard"}
  ],
  "synchronous": true,
  "step_cycle_ms": 200,
  "recording": {
    "enable": false,
    "output_dir": "./artifacts"
  },
  "vnc": {
    "enable": false
  },
  "ssh": {
    "user": "lume",
    "shell": "bash",
    "note": "use.computer's lume user has passwordless sudo; SSH transport is gateway-proxied (no local port)."
  },
  "security": {
    "user": "lume"
  },
  "user_accounts": [
    {
      "name": "lume",
      "role": "developer",
      "note": "Default use.computer sandbox user; passwordless sudo configured by the operator.",
      "permissions": {
        "sudo": true,
        "sudo_nopasswd": true,
        "shell": "/bin/zsh",
        "home_dir": "/Users/lume",
        "groups": ["staff", "admin"]
      }
    }
  ],
  "tags": ["macos", "use_computer", "remote", "apple_silicon"]
}
