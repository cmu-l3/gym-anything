[Unit]
Description=Gym Anything TigerVNC desktop
Requires=ga-snap-transitions.service
After=dbus.service network.target ga-snap-transitions.service

[Service]
Type=simple
User=ga
PAMName=login
EnvironmentFile=-/etc/gym-anything/vnc.env
ExecStartPre=-/usr/bin/vncserver -kill :1
ExecStart=/usr/bin/vncserver :1 -geometry ${GA_VNC_GEOMETRY} -depth 24 -localhost no -fg
ExecStop=-/usr/bin/vncserver -kill :1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
