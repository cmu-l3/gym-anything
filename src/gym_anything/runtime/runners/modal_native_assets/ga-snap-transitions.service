[Unit]
Description=Complete Ubuntu package-to-Snap transitions
After=network-online.target snapd.socket
Wants=network-online.target snapd.socket
ConditionPathExists=/var/lib/gym-anything/snap-transitions/packages

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ga-snap-transitions replay
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
