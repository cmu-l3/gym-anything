# use.computer macOS sandboxes (UseComputerRunner). The env var the runner
# actually reads is USE_COMPUTER_API_KEY (previously misnamed USE_COMPUTER).
# USE_COMPUTER_BASE_URL is optional and defaults to https://api.use.computer
# (prod). Use https://api.dev.use.computer for a dev-fleet key — keys are
# scoped per-env, so a prod key returns 401 against dev and vice versa.
USE_COMPUTER_API_KEY=""
USE_COMPUTER_BASE_URL=""
