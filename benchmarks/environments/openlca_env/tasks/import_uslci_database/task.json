{
  "id": "import_uslci_database@1",
  "version": "1.0",
  "env_id": "openlca_env@0.1",
  "description": "In openLCA, create a new empty database named 'USLCI_Analysis', then import the USLCI (U.S. Life Cycle Inventory) database from the JSON-LD zip file at ~/LCA_Imports/uslci_database.zip. After import, verify the database contains USLCI processes and flows by browsing the navigation tree.",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 300,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/import_uslci_database/setup_task.sh",
    "post_task": "/workspace/tasks/import_uslci_database/export_result.sh"
  },
  "metadata": {
    "database_name": "USLCI_Analysis",
    "import_file": "uslci_database.zip",
    "expected_min_processes": 10,
    "expected_categories": ["Processes", "Flows", "Flow properties"]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_import_uslci_database"
    }
  }
}
