{
  "id": "payment_method_autofill@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Chrome's payment methods settings and add a credit card for autofill. Add card for 'Alex Chen' with number 4532 1488 0343 6467, expiring 12/2027.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/payment_method_autofill/setup_task.sh",
    "post_task": "/workspace/tasks/payment_method_autofill/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}