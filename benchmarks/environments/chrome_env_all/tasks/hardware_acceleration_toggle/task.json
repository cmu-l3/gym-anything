{
  "id": "hardware_acceleration_toggle@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Chrome Settings > System and disable hardware acceleration to troubleshoot graphics rendering issues or test performance differences.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 7,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/hardware_acceleration_toggle/setup_task.sh",
    "post_task": "/workspace/tasks/hardware_acceleration_toggle/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}