{
  "id": "multi_window_tab_organization@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Organize multiple tabs across two Chrome windows: Window 1 (GitHub, Stack Overflow) and Window 2 (MDN, Node.js, Python docs)",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/multi_window_tab_organization/setup_task.sh",
    "post_task": "/workspace/tasks/multi_window_tab_organization/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}