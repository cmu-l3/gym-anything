{
  "id": "custom_spell_check_dictionary@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Add custom technical terms (TensorFlow, Kubernetes, PostgreSQL, Dockerfile) to Chrome's spell check dictionary for improved typing experience",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/custom_spell_check_dictionary/setup_task.sh",
    "post_task": "/workspace/tasks/custom_spell_check_dictionary/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}