{
  "id": "page_rendering_debug@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Diagnose and fix a webpage rendering issue using Chrome DevTools. The page has CSS not loading properly - investigate Console errors and clear cache to resolve.",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/page_rendering_debug/setup_task.sh",
    "post_task": "/workspace/tasks/page_rendering_debug/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}