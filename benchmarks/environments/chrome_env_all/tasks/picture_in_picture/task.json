{
  "id": "picture_in_picture@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Activate Picture-in-Picture mode for a video by right-clicking on the video player and selecting 'Picture in Picture' from the context menu",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/picture_in_picture/setup_task.sh",
    "post_task": "/workspace/tasks/picture_in_picture/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}