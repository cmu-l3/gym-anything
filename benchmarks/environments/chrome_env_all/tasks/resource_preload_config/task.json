{
  "id": "resource_preload_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome's resource preloading to Extended mode for maximum page load performance by navigating to Settings and adjusting network prediction settings.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/resource_preload_config/setup_task.sh",
    "post_task": "/workspace/tasks/resource_preload_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}