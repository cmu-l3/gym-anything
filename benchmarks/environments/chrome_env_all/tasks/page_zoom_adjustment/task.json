{
  "id": "page_zoom_adjustment@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Adjust webpage zoom level to 150% for improved readability using Chrome's zoom controls",
  "init": {
    "timeout_sec": 60,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/page_zoom_adjustment/setup_task.sh",
    "post_task": "/workspace/tasks/page_zoom_adjustment/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}