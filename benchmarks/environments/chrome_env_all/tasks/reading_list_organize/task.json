{
  "id": "reading_list_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome's Reading List feature to save three articles (Wikipedia Python, TechCrunch, MDN Web Docs) for later reading and mark one as read",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/reading_list_organize/setup_task.sh",
    "post_task": "/workspace/tasks/reading_list_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}