{
  "id": "localstorage_editor@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome DevTools Application panel to add localStorage entries: 'user_preference'='dark_mode' and 'session_count'='5'",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/localstorage_editor/setup_task.sh",
    "post_task": "/workspace/tasks/localstorage_editor/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}