{
  "id": "extension_shortcuts_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure a custom keyboard shortcut (Ctrl+Shift+E) for a Chrome extension by navigating to chrome://extensions/shortcuts and assigning the shortcut.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extension_shortcuts_config/setup_task.sh",
    "post_task": "/workspace/tasks/extension_shortcuts_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}