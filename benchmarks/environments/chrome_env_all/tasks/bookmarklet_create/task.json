{
  "id": "bookmarklet_create@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Create a JavaScript bookmarklet named 'Page Highlighter' that highlights all paragraphs on a webpage with yellow background color.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmarklet_create/setup_task.sh",
    "post_task": "/workspace/tasks/bookmarklet_create/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}