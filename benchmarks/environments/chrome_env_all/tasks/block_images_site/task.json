{
  "id": "block_images_site@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to example.com and configure site-specific settings to block images for that domain to improve page load speed and reduce bandwidth usage.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/block_images_site/setup_task.sh",
    "post_task": "/workspace/tasks/block_images_site/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}