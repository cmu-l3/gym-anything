{
  "id": "startup_pages_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to automatically open multiple productivity pages on startup (email, calendar, project tools) to establish a consistent morning routine.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/startup_pages_config/setup_task.sh",
    "post_task": "/workspace/tasks/startup_pages_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}