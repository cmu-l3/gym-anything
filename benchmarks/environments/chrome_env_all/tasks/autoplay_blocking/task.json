{
  "id": "autoplay_blocking@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to block auto-playing media on a disruptive news website by accessing site-specific permissions and setting autoplay to 'Block'",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/autoplay_blocking/setup_task.sh",
    "post_task": "/workspace/tasks/autoplay_blocking/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  },
  "metadata": {
    "target_domain": "bbc.com",
    "difficulty": "intermediate",
    "category": "site_permissions"
  }
}