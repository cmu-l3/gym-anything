{
  "id": "custom_download_location@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Configure Chrome to download files to a custom location, then download a test file to verify the configuration works correctly.",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/custom_download_location/setup_task.sh",
    "post_task": "/workspace/tasks/custom_download_location/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}