{
  "id": "resource_heavy_tab_cleanup@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome Task Manager to identify and close resource-heavy tabs while preserving important work tabs to improve browser performance",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/resource_heavy_tab_cleanup/setup_task.sh",
    "post_task": "/workspace/tasks/resource_heavy_tab_cleanup/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}