{
  "id": "find_in_page_navigate@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's Find in Page feature to search for 'temperature' in a Wikipedia article and navigate to the 5th occurrence using keyboard navigation",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/find_in_page_navigate/setup_task.sh",
    "post_task": "/workspace/tasks/find_in_page_navigate/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}