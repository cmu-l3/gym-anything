{
  "id": "print_to_pdf_landscape@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Export a webpage as a PDF file with landscape orientation using Chrome's print dialog. Save as 'webpage_landscape_export.pdf' in Downloads folder.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/print_to_pdf_landscape/setup_task.sh",
    "post_task": "/workspace/tasks/print_to_pdf_landscape/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}