{
  "id": "print_to_pdf_archive@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Print a webpage receipt to PDF with headers and footers disabled to create a clean archival document suitable for expense reports",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/print_to_pdf_archive/setup_task.sh",
    "post_task": "/workspace/tasks/print_to_pdf_archive/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}