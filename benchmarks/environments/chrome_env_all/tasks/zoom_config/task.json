{
  "id": "zoom_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Configure Chrome's default page zoom level to improve readability by increasing it from the default 100% to a larger size (e.g., 125% or 150%).",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/zoom_config/setup_zoom_task.sh",
    "post_task": "/workspace/tasks/zoom_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}