{
  "id": "tab_groups_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Organize open tabs into logical, color-coded groups with meaningful names (e.g., Documentation, Social, Shopping, News)",
  "init": {
    "timeout_sec": 180,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_groups_organize/setup_task.sh",
    "post_task": "/workspace/tasks/tab_groups_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}