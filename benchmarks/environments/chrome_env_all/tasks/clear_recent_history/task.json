{
  "id": "clear_recent_history@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's Clear Browsing Data feature to selectively delete browsing history from the last 24 hours while preserving older entries",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_recent_history/setup_task.sh",
    "post_task": "/workspace/tasks/clear_recent_history/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}