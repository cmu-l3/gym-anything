{
  "id": "flags_smooth_scrolling@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to chrome://flags, search for 'smooth scrolling', enable the flag, and relaunch Chrome to apply the experimental feature configuration.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/flags_smooth_scrolling/setup_task.sh",
    "post_task": "/workspace/tasks/flags_smooth_scrolling/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}