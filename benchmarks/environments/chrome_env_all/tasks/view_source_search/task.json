{
  "id": "view_source_search@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "View a webpage's HTML source code and search for specific keywords using Chrome's view source feature (Ctrl+U)",
  "init": {
    "timeout_sec": 90,
    "max_steps": 7,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/view_source_search/setup_task.sh",
    "post_task": "/workspace/tasks/view_source_search/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}