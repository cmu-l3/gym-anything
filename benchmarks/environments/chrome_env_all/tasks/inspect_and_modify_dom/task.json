{
  "id": "inspect_and_modify_dom@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome Developer Tools to inspect a button element and change its background color from blue to green (#28a745)",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/inspect_and_modify_dom/setup_task.sh",
    "post_task": "/workspace/tasks/inspect_and_modify_dom/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}