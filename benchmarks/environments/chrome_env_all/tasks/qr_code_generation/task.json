{
  "id": "qr_code_generation@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's built-in QR code generator to create a QR code for a webpage and download it as an image file",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/qr_code_generation/setup_task.sh",
    "post_task": "/workspace/tasks/qr_code_generation/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}