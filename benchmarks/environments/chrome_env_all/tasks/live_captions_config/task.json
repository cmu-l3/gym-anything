{
  "id": "live_captions_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Enable Chrome Live Captions and customize caption styling (text size, font, colors) for improved accessibility.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/live_captions_config/setup_task.sh",
    "post_task": "/workspace/tasks/live_captions_config/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}