{
  "id": "clear_browsing_data@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Clear your browsing history from the last hour while preserving older history and other browser data (cookies, cache).",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_browsing_data/setup_task.sh",
    "post_task": "/workspace/tasks/clear_browsing_data/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}