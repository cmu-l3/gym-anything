{
  "id": "bookmark_search_bulk_move@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Bookmark Manager to search for tech news bookmarks (TechCrunch, The Verge), select multiple results, create 'Tech News' folder, and move all matching bookmarks into it",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_search_bulk_move/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_search_bulk_move/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}