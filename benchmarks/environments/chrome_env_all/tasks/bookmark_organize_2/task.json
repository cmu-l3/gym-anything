{
  "id": "bookmark_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Organize scattered bookmarks on the bookmark bar into logical category folders (News, Shopping, Social, Dev Resources).",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_organize/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}