{
  "id": "data_saver_setup@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome's data-saving settings to optimize for slow/metered connections by disabling preloading and reducing bandwidth usage in Settings.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/data_saver_setup/setup_task.sh",
    "post_task": "/workspace/tasks/data_saver_setup/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}