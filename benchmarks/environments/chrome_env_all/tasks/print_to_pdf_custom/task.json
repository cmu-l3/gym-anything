{
  "id": "print_to_pdf_custom@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Print a webpage to PDF with custom settings: landscape orientation, minimum margins, and no headers/footers. Save as 'custom_print.pdf'.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/print_to_pdf_custom/setup_task.sh",
    "post_task": "/workspace/tasks/print_to_pdf_custom/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}