{
  "id": "multi_file_download@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Download multiple files (PDF, PNG, TXT) from a webpage and verify all files are saved to the Downloads folder",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/multi_file_download/setup_task.sh",
    "post_task": "/workspace/tasks/multi_file_download/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}