{
  "id": "find_in_page@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome's Find in Page feature (Ctrl+F) to search for 'climate' on a Wikipedia article, verify matches are found, and navigate through at least 2 matches",
  "init": {
    "timeout_sec": 90,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/find_in_page/setup_task.sh",
    "post_task": "/workspace/tasks/find_in_page/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}