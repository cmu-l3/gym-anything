{
  "id": "safe_browsing_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome's Safe Browsing to Enhanced protection level for improved security. Navigate to Settings > Privacy and security > Security, then select Enhanced protection.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/safe_browsing_config/setup_task.sh",
    "post_task": "/workspace/tasks/safe_browsing_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}