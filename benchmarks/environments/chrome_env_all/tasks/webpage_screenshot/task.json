{
  "id": "webpage_screenshot@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Capture a screenshot of a webpage using Chrome's built-in DevTools screenshot functionality and save it to the Downloads folder",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/webpage_screenshot/setup_task.sh",
    "post_task": "/workspace/tasks/webpage_screenshot/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}