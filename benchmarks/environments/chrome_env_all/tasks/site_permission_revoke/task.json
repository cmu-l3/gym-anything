{
  "id": "site_permission_revoke@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Revoke notification permission for a specific website (news-daily-times.example) that sends spam notifications, while preserving permissions for other important sites",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/site_permission_revoke/setup_permissions.sh",
    "post_task": "/workspace/tasks/site_permission_revoke/export_preferences.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}