{
  "id": "experimental_flag_enable@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to chrome://flags and enable the 'Parallel downloading' experimental feature to improve download performance",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "metadata": {
    "target_flag_internal": "enable-parallel-downloading",
    "target_flag_display": "Parallel downloading",
    "difficulty": "intermediate"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/experimental_flag_enable/setup_task.sh",
    "post_task": "/workspace/tasks/experimental_flag_enable/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}