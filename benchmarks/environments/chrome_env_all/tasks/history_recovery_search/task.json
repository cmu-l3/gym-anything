{
  "id": "history_recovery_search@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's browsing history to locate and recover a previously visited webpage about REST API authentication that was accessed 2-3 days ago but wasn't bookmarked",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/history_recovery_search/setup_task.sh",
    "post_task": "/workspace/tasks/history_recovery_search/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}