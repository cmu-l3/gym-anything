{
  "id": "save_page_as_pdf@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Save a customer support chat webpage as PDF for documentation purposes. Use Ctrl+P to open print dialog, select 'Save as PDF', and save with a descriptive filename.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/save_page_as_pdf/setup_task.sh",
    "post_task": "/workspace/tasks/save_page_as_pdf/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}