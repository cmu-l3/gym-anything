{
  "id": "local_storage_edit@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome DevTools Application panel to inspect and modify localStorage: add 'theme':'dark' key-value pair and change 'language' from 'en' to 'es'",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/local_storage_edit/setup_task.sh",
    "post_task": "/workspace/tasks/local_storage_edit/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}