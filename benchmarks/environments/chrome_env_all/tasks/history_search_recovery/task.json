{
  "id": "history_search_recovery@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's history search to find and navigate back to a previously visited renewable energy statistics webpage using partial recollection",
  "init": {
    "timeout_sec": 90,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/history_search_recovery/setup_history_task.sh",
    "post_task": "/workspace/tasks/history_search_recovery/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}