{
  "id": "autofill_address@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome autofill by adding a complete mailing address (John Anderson, 742 Evergreen Terrace, Springfield, IL 62701) through Settings",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/autofill_address/setup_task.sh",
    "post_task": "/workspace/tasks/autofill_address/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}