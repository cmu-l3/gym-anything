{
  "id": "multi_tab_session@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Open multiple research tabs in Chrome: Wikipedia, GitHub, Stack Overflow, and MDN Web Docs. Use Ctrl+T to create new tabs and navigate to each URL.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/multi_tab_session/setup_multi_tab_task.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_multi_tab_session"
    }
  }
}