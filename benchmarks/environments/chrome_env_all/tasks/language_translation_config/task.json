{
  "id": "language_translation_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome language preferences: add Spanish, enable spell-check for Spanish, and disable automatic translation offers for Spanish",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/language_translation_config/setup_task.sh",
    "post_task": "/workspace/tasks/language_translation_config/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}