{
  "id": "history_search_delete@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Search Chrome browsing history for shopping-related entries and selectively delete them while preserving news and work-related history",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/history_search_delete/setup_task.sh",
    "post_task": "/workspace/tasks/history_search_delete/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}