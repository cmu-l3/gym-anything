{
  "id": "lighthouse_audit@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Run a Lighthouse performance and accessibility audit on a webpage, generate a comprehensive report, and save it for analysis",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/lighthouse_audit/setup_task.sh",
    "post_task": "/workspace/tasks/lighthouse_audit/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}