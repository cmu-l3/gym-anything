{
  "id": "history_bulk_bookmark@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Search Chrome history for 'python' keyword, select multiple matching entries, and bulk bookmark them into a new 'Python Resources' folder in the bookmarks bar.",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/history_bulk_bookmark/setup_task.sh",
    "post_task": "/workspace/tasks/history_bulk_bookmark/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}