{
  "id": "bookmark_deduplicate@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Identify and remove duplicate bookmarks across all folders while preserving one instance of each unique URL",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_deduplicate/setup_bookmark_dupes.sh",
    "post_task": "/workspace/tasks/bookmark_deduplicate/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}