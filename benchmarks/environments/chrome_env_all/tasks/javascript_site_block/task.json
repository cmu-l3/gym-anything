{
  "id": "javascript_site_block@1",
  "version": "1.0",
  "env_id": "examples.chrome_env_all@0.1",
  "description": "Block JavaScript execution on ads.example.com using Chrome's site-specific content settings. Navigate to Settings > Privacy and security > Site Settings > JavaScript, and add the site to the blocked list.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "info": {
    "target_site": "ads.example.com",
    "block_setting": 2
  },
  "hooks": {
    "pre_task": "/workspace/tasks/javascript_site_block/setup_task.sh",
    "post_task": "/workspace/tasks/javascript_site_block/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}