{
  "id": "password_export_csv@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Export Chrome saved passwords to CSV file by navigating to Password Manager and using the export functionality. Save as 'chrome_passwords_export.csv' in Downloads folder.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/password_export_csv/setup_task.sh",
    "post_task": "/workspace/tasks/password_export_csv/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}