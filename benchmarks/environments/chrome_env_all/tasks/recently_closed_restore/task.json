{
  "id": "recently_closed_restore@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Restore previously closed tabs (Wikipedia and GitHub) using Chrome's Recently Closed feature via menu or Ctrl+Shift+T shortcut",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/recently_closed_restore/setup_restore_task.sh",
    "post_task": "/workspace/tasks/recently_closed_restore/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}