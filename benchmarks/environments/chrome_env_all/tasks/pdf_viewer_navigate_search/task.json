{
  "id": "pdf_viewer_navigate_search@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Open a PDF document in Chrome, use the search functionality to find the term 'hypothesis', and navigate to the 3rd occurrence which appears on page 7 of the document.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/pdf_viewer_navigate_search/setup_task.sh",
    "post_task": "/workspace/tasks/pdf_viewer_navigate_search/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}