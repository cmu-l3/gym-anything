{
  "id": "profile_customization@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Customize Chrome profile by changing both the profile name and avatar icon. Access profile settings, set a custom name (not 'Person 1'), and select a different avatar icon.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/profile_customization/setup_task.sh",
    "post_task": "/workspace/tasks/profile_customization/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}