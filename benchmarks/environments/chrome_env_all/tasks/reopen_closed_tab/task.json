{
  "id": "reopen_closed_tab@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Recover an accidentally closed tab using Chrome's 'Reopen closed tab' feature (Ctrl+Shift+T). A Wikipedia article tab was accidentally closed and needs to be restored.",
  "init": {
    "timeout_sec": 45,
    "max_steps": 5,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/reopen_closed_tab/setup_task.sh",
    "post_task": "/workspace/tasks/reopen_closed_tab/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}