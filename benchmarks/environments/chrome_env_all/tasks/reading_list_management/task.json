{
  "id": "reading_list_management@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Add three developer documentation pages to Chrome's Reading List for later reading: Chrome Extensions docs, Web.dev articles, and MDN JavaScript docs",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/reading_list_management/setup_task.sh",
    "post_task": "/workspace/tasks/reading_list_management/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}