{
  "id": "bookmark_export@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Export Chrome bookmarks to an HTML file for backup before system reinstall. Access Bookmark Manager and export bookmarks as 'chrome_bookmarks_backup.html'.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_export/setup_bookmarks.sh",
    "post_task": "/workspace/tasks/bookmark_export/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}