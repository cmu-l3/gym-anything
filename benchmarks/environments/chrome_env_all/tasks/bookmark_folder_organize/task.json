{
  "id": "bookmark_folder_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Create a 'Tech Resources' folder in the Bookmark Bar and add three bookmarks: GitHub, Stack Overflow, and MDN Web Docs with their respective URLs.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_folder_organize/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_folder_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}