{
  "id": "tab_pinning_workflow@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Pin Gmail and Calendar tabs to keep them persistent and easily accessible in the leftmost positions",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_pinning_workflow/setup_task.sh",
    "post_task": "/workspace/tasks/tab_pinning_workflow/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}