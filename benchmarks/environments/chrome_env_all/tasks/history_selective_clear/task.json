{
  "id": "history_selective_clear@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Search Chrome browsing history for entries containing a specific keyword and selectively delete them while preserving other history entries",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "config": {
    "target_keyword": "example"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/history_selective_clear/setup_task.sh",
    "post_task": "/workspace/tasks/history_selective_clear/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}