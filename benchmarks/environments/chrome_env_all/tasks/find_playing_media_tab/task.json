{
  "id": "find_playing_media_tab@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Identify and navigate to the tab that is currently playing media (audio or video) among multiple open tabs",
  "init": {
    "timeout_sec": 60,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/find_playing_media_tab/setup_task.sh",
    "post_task": "/workspace/tasks/find_playing_media_tab/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}