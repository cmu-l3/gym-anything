{
  "id": "print_settings_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome print settings to save a webpage as PDF with landscape orientation and minimal margins. Save as 'webpage_print_landscape.pdf'.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/print_settings_config/setup_task.sh",
    "post_task": "/workspace/tasks/print_settings_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}