{
  "id": "site_specific_zoom@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure different zoom levels for three different websites: example.com (150%), info.cern.ch (75%), and textfiles.com (125%) to demonstrate per-site zoom customization",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/site_specific_zoom/setup_task.sh",
    "post_task": "/workspace/tasks/site_specific_zoom/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}