{
  "id": "research_archive_workflow@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Create a comprehensive research archive: navigate to article, create organized bookmark folder, add to Reading List, and save as PDF",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/research_archive_workflow/setup_task.sh",
    "post_task": "/workspace/tasks/research_archive_workflow/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}