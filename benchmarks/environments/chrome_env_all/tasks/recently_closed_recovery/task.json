{
  "id": "recently_closed_recovery@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Open 4 specific tabs, close 3 of them, then use Chrome's Recently Closed feature to selectively recover 2 tabs (GitHub and Hacker News) while leaving Stack Overflow closed",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/recently_closed_recovery/setup_task.sh",
    "post_task": "/workspace/tasks/recently_closed_recovery/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}