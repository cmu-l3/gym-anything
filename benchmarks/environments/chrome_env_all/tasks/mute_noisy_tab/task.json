{
  "id": "mute_noisy_tab@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Locate and mute a tab playing audio among multiple open tabs without closing it. The tab displays a speaker icon indicating audio playback.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/mute_noisy_tab/setup_task.sh",
    "post_task": "/workspace/tasks/mute_noisy_tab/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}