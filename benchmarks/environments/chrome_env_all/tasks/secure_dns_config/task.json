{
  "id": "secure_dns_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome's Secure DNS (DNS-over-HTTPS) to use Cloudflare (1.1.1.1) for enhanced privacy and security",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/secure_dns_config/setup_task.sh",
    "post_task": "/workspace/tasks/secure_dns_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}