{
  "id": "tab_recovery_undo@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Close the GitHub tab (middle tab) and recover it using Ctrl+Shift+T to test Chrome's tab recovery feature",
  "init": {
    "timeout_sec": 60,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_recovery_undo/setup_task.sh",
    "post_task": "/workspace/tasks/tab_recovery_undo/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}