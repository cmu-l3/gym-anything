{
  "id": "reading_list_add@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Add a Wikipedia article on Artificial Intelligence to Chrome's Reading List feature for later reading",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/reading_list_add/setup_task.sh",
    "post_task": "/workspace/tasks/reading_list_add/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}