{
  "id": "bookmark_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to GitHub trending page, create a 'Dev Resources' folder in bookmarks bar, and save the page as 'Trending Projects' in that folder",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_organize/setup_bookmark_task.sh",
    "post_task": "/workspace/tasks/bookmark_organize/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}