{
  "id": "memory_saver_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Chrome's performance settings (chrome://settings/performance) and enable Memory Saver mode to automatically free up memory from inactive tabs.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/memory_saver_config/setup_task.sh",
    "post_task": "/workspace/tasks/memory_saver_config/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}