{
  "id": "site_notification_block@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to block notification requests from a specific website (nytimes.com) by navigating to Settings > Privacy and security > Site Settings > Notifications and adding the site to the block list.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/site_notification_block/setup_task.sh",
    "post_task": "/workspace/tasks/site_notification_block/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  },
  "task_params": {
    "target_site": "nytimes.com",
    "target_url": "https://www.nytimes.com"
  }
}