{
  "id": "page_translation@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Translate a Spanish language webpage to English using Chrome's built-in translation feature. Navigate to a Spanish Wikipedia article and trigger translation.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/page_translation/setup_task.sh",
    "post_task": "/workspace/tasks/page_translation/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}