{
  "id": "autofill_address_profile@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Create a complete AutoFill address profile in Chrome with specific personal information (Sarah Mitchell, 742 Evergreen Terrace, Springfield IL 62704)",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/autofill_address_profile/setup_task.sh",
    "post_task": "/workspace/tasks/autofill_address_profile/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}