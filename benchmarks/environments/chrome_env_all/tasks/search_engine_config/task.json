{
  "id": "search_engine_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Chrome settings and change the default search engine from Google to DuckDuckGo for improved privacy.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/search_engine_config/setup_task.sh",
    "post_task": "/workspace/tasks/search_engine_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}