{
  "id": "research_bookmark_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Organize open research tabs by creating a 'Research' folder with sub-folders (Papers, Datasets, Tools) in bookmarks bar and bookmarking tabs into appropriate categories",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/research_bookmark_organize/setup_research_task.sh",
    "post_task": "/workspace/tasks/research_bookmark_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}