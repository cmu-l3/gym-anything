{
  "id": "devtools_localstorage_edit@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome DevTools Application tab to inspect and modify localStorage: edit 'theme' to 'dark', add 'notifications'='enabled', delete 'fontSize', preserve 'username'",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/devtools_localstorage_edit/setup_task.sh",
    "post_task": "/workspace/tasks/devtools_localstorage_edit/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}