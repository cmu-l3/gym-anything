{
  "id": "homepage_button_config@1",
  "version": "1.0",
  "env_id": "chrome_env_all@0.1",
  "description": "Enable Chrome's home button and configure Wikipedia as homepage URL",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/homepage_button_config/setup_task.sh",
    "post_task": "/workspace/tasks/homepage_button_config/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}