{
  "id": "create_tiddler@1",
  "version": "1.0",
  "env_id": "tiddly_wiki_env@0.1",
  "description": "Create a tiddler titled 'Machine Learning Pipeline Architecture' covering data ingestion, model training, and deployment. Tag it with 'Technology' and 'MachineLearning'. Write at least 100 words. Structure the content with headings and bullet points.",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_tiddler/setup_task.sh",
    "post_task": "/workspace/tasks/create_tiddler/export_result.sh"
  },
  "metadata": {
    "expected_title": "Machine Learning Pipeline Architecture",
    "expected_tags": ["Technology", "MachineLearning"],
    "min_word_count": 100,
    "expected_keywords": ["data", "model", "training", "pipeline"]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_tiddler"
    }
  }
}
