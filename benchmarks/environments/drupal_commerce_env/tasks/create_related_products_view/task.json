{
  "id": "create_related_products_view@1",
  "version": "1.0",
  "env_id": "drupal_commerce_env@0.1",
  "name": "create_related_products_view",
  "description": "Create a 'Related Products' block using Views that displays 3 random products on product detail pages, excluding the current product.",
  "difficulty": "hard",
  "init": {
    "timeout_sec": 600,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "chmod +x /workspace/tasks/create_related_products_view/setup_task.sh && bash -l /workspace/tasks/create_related_products_view/setup_task.sh",
    "post_task": "chmod +x /workspace/tasks/create_related_products_view/export_result.sh && bash -l /workspace/tasks/create_related_products_view/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_related_products_view"
    }
  }
}
