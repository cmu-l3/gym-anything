{
  "id": "import_bank_statement@1",
  "version": "1.0",
  "env_id": "manager_env@0.1",
  "description": "Import the bank statement file located at '~/Documents/bank_statement_january.csv' into the 'Cash on Hand' bank account in Manager.io. \n\n1. Navigate to 'Bank and Cash Accounts'.\n2. Click on the 'Cash on Hand' account to view its transactions.\n3. Click 'Import Bank Statement' and upload the CSV file.\n4. Ensure columns are mapped correctly (Date, Description, Amount) and complete the import.\n5. Verify that 8 new transactions appear in the account.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/import_bank_statement/setup_task.sh",
    "post_task": "/workspace/tasks/import_bank_statement/export_result.sh"
  },
  "metadata": {
    "csv_path": "/home/ga/Documents/bank_statement_january.csv",
    "account_name": "Cash on Hand",
    "expected_transaction_count": 8,
    "expected_descriptions": [
      "Payment received - Alfreds Futterkiste INV-001",
      "Transfer to Exotic Liquids - PO-2024-001",
      "Office rent payment - January 2024",
      "Utility bill - City Power & Light",
      "Payment received - Ernst Handel INV-002",
      "Office supplies - Staples order",
      "Payment received - Alfreds Futterkiste INV-003",
      "Bank service charges"
    ],
    "expected_amounts": [
      "2,500.00", "-1,800.00", "-1,200.00", "-350.00", "4,200.00", "-275.50", "1,850.00", "-45.00"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_import_bank_statement"
    }
  }
}