{
  "id": "course_conflict_checker@1",
  "version": "1.0",
  "env_id": "libreoffice_calc_env@0.1",
  "description": "Analyze college course schedule to identify time conflicts, apply conditional formatting, and calculate credit hours with enrollment status",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/course_conflict_checker/setup_task.sh",
    "post_task": "/workspace/tasks/course_conflict_checker/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_course_conflict_checker"
    }
  }
}