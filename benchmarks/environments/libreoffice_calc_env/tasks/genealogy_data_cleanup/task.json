{
  "id": "genealogy_data_cleanup@1",
  "version": "1.0",
  "env_id": "libreoffice_calc_env@0.1",
  "description": "Clean and consolidate messy genealogy data: standardize dates, identify duplicates, add validation formulas, flag logical errors, apply conditional formatting, and organize by family groups.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/genealogy_data_cleanup/setup_task.sh",
    "post_task": "/workspace/tasks/genealogy_data_cleanup/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_genealogy_cleanup"
    }
  }
}