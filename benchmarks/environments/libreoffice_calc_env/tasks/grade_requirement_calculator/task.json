{
  "id": "grade_requirement_calculator@1",
  "version": "1.0",
  "env_id": "libreoffice_calc_env@0.1",
  "description": "Calculate required scores on remaining assignments to achieve target final grade. Help a student determine what they need on their final exam and project to earn a B+ (87%) in their course.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/grade_requirement_calculator/setup_task.sh",
    "post_task": "/workspace/tasks/grade_requirement_calculator/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_grade_calculator"
    }
  }
}