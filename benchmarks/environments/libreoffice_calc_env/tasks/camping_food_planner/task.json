{
  "id": "camping_food_planner@1",
  "version": "1.0",
  "env_id": "libreoffice_calc_env@0.1",
  "description": "Create a camping trip food planning spreadsheet with quantity calculations, dietary restrictions, shopping list, and fair cost splitting for a 7-person, 5-day trip",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/camping_food_planner/setup_task.sh",
    "post_task": "/workspace/tasks/camping_food_planner/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_camping_food_planner"
    }
  }
}