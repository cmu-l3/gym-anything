{
  "id": "nba_scouting_comparison@1",
  "version": "1.0",
  "env_id": "firefox_env@0.1",
  "description": "Research career statistics for three NBA players (LeBron James, Stephen Curry, and Nikola Jokić) on Basketball Reference (basketball-reference.com). Create a bookmark folder named 'NBA Scouting' and save the player page for each athlete in it (at least 3 bookmarks). Then, create a JSON file at ~/Documents/nba_comparison.json containing their career regular-season averages for Points (ppg), Assists (apg), Rebounds (rpg), total Seasons played, and Championships won. The JSON should have keys 'lebron_james', 'stephen_curry', and 'nikola_jokic'.",
  "difficulty": "medium",
  "tags": ["firefox", "research", "data-entry", "bookmarks", "json"],
  "init": {
    "timeout_sec": 600,
    "max_steps": 80,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/nba_scouting_comparison/setup_task.sh",
    "post_task": "/workspace/tasks/nba_scouting_comparison/export_result.sh"
  },
  "metadata": {
    "required_output_file": "/home/ga/Documents/nba_comparison.json",
    "required_bookmark_folder": "NBA Scouting",
    "target_domain": "basketball-reference.com",
    "players": {
      "lebron_james": {
        "ppg_range": [24.0, 30.0],
        "apg_range": [6.0, 9.0],
        "rpg_range": [6.5, 8.5],
        "seasons_range": [20, 25],
        "championships_range": [4, 4]
      },
      "stephen_curry": {
        "ppg_range": [22.0, 27.0],
        "apg_range": [5.5, 7.5],
        "rpg_range": [3.5, 6.0],
        "seasons_range": [14, 18],
        "championships_range": [4, 4]
      },
      "nikola_jokic": {
        "ppg_range": [18.0, 24.0],
        "apg_range": [5.5, 8.5],
        "rpg_range": [9.0, 13.0],
        "seasons_range": [8, 13],
        "championships_range": [1, 3]
      }
    }
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_nba_scouting_comparison"
    }
  }
}