{
  "id": "aggregate_hotel_country_metrics@1",
  "version": "1.0",
  "env_id": "orientdb_env@0.1",
  "description": "Business intelligence reported the executive dashboard cannot compute country-level hotel density because no aggregated summary layer exists in the graph. Use OrientDB Studio at http://localhost:2480/studio/index.html with server credentials root / GymAnything123! and connect to demodb. Build a denormalized HotelCountryMetrics vertex class capturing per-country total hotel counts and five-star luxury counts, with a unique index on Country and a report batch tag.",
  "difficulty": "very_hard",
  "init": {
    "timeout_sec": 780,
    "max_steps": 100,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/aggregate_hotel_country_metrics/setup_task.sh",
    "post_task": "/workspace/tasks/aggregate_hotel_country_metrics/export_result.sh"
  },
  "metadata": {
    "expected_metrics": {
      "Italy":          { "TotalHotels": 3, "LuxuryCount": 2 },
      "Germany":        { "TotalHotels": 2, "LuxuryCount": 1 },
      "France":         { "TotalHotels": 2, "LuxuryCount": 1 },
      "United Kingdom": { "TotalHotels": 1, "LuxuryCount": 1 },
      "United States":  { "TotalHotels": 1, "LuxuryCount": 1 },
      "Japan":          { "TotalHotels": 1, "LuxuryCount": 1 },
      "Australia":      { "TotalHotels": 1, "LuxuryCount": 1 },
      "Brazil":         { "TotalHotels": 1, "LuxuryCount": 1 },
      "Spain":          { "TotalHotels": 1, "LuxuryCount": 1 },
      "Greece":         { "TotalHotels": 1, "LuxuryCount": 1 },
      "Netherlands":    { "TotalHotels": 1, "LuxuryCount": 1 }
    },
    "luxury_definition": "Hotels.Stars = 5",
    "report_batch": "bi_q1_2026",
    "valid_countries": ["Italy","Germany","France","United Kingdom","United States","Japan","Australia","Brazil","Spain","Greece","Netherlands"]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_aggregate_hotel_country_metrics"
    }
  }
}
