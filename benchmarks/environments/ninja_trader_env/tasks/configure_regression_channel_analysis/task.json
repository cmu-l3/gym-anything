{
  "id": "configure_regression_channel_analysis@1",
  "version": "1.0",
  "env_id": "ninja_trader_env@0.1",
  "description": "Create a new Daily chart for SPY (S&P 500 ETF) in NinjaTrader 8. Configure the following indicators on the chart:\n\n1. **Regression Channel** (Overlay on price)\n   - Period: 50\n   - Width: 2\n\n2. **R-Squared** (Sub-panel)\n   - Period: 50\n\n3. **Stochastics** (Sub-panel)\n   - Period D: 3\n   - Period K: 14\n   - Smooth: 3\n\nOnce configured, save the workspace to ensure your changes are persisted.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 480,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "powershell -ExecutionPolicy Bypass -File C:\\workspace\\tasks\\configure_regression_channel_analysis\\setup_task.ps1",
    "post_task": "powershell -ExecutionPolicy Bypass -File C:\\workspace\\tasks\\configure_regression_channel_analysis\\export_result.ps1"
  },
  "metadata": {
    "instrument": "SPY",
    "indicators": {
      "RegressionChannel": {"period": 50, "width": 2},
      "RSquared": {"period": 50},
      "Stochastics": {"period_k": 14, "period_d": 3, "smooth": 3}
    },
    "result_path": "C:\\Users\\Docker\\Desktop\\NinjaTraderTasks\\configure_regression_channel_analysis_result.json"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_regression_channel_analysis"
    }
  }
}