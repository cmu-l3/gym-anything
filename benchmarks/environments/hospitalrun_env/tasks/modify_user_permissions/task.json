{
  "id": "modify_user_permissions@1",
  "version": "1.0",
  "env_id": "hospitalrun_env@0.1",
  "description": "Grant administrative privileges to Dr. James Miller. Navigate to the Administration section (gear icon), then to Users. Locate the user 'Dr. James Miller' (username: jmiller) and edit their account. Add the 'System Administrator' role to their existing roles. Save the user account.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/modify_user_permissions/setup_task.sh",
    "post_task": "/workspace/tasks/modify_user_permissions/export_result.sh"
  },
  "metadata": {
    "target_username": "jmiller",
    "target_doc_id": "org.couchdb.user:jmiller",
    "required_role": "System Administrator",
    "initial_role": "Doctor",
    "couch_users_db": "_users"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_modify_user_permissions"
    }
  }
}