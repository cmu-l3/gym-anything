{
  "id": "identify_low_stock_items@1",
  "version": "1.0",
  "env_id": "hospitalrun_env@0.1",
  "description": "Perform an inventory audit in HospitalRun. Navigate to the Inventory section to review current stock levels. Identify all items with a quantity strictly less than 20. Create a text file at '/home/ga/low_stock_report.txt' and list the exact names of these low-stock items, one per line. Do not include items with 20 or more units.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/identify_low_stock_items/setup_task.sh",
    "post_task": "/workspace/tasks/identify_low_stock_items/export_result.sh"
  },
  "metadata": {
    "report_path": "/home/ga/low_stock_report.txt",
    "threshold": 20,
    "expected_low_items": [
      "Amoxicillin 500mg",
      "Sterile Gauze Pads",
      "Disposable Syringes 10ml"
    ],
    "expected_high_items": [
      "Surgical Gloves (Size M)",
      "Saline Solution 1L",
      "N95 Respirator Masks"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_identify_low_stock_items"
    }
  }
}