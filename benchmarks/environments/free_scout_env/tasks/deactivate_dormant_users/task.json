{
  "id": "deactivate_dormant_users@1",
  "version": "1.0",
  "env_id": "free_scout_env@0.1",
  "description": "Perform a security audit of user accounts in FreeScout. Identify and deactivate (disable) any user accounts that have not logged in for more than 90 days, or have never logged in. Do NOT delete the accounts; only change their status to inactive. Ensure active users (logged in within the last 90 days) remain active.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/deactivate_dormant_users/setup_task.sh",
    "post_task": "/workspace/tasks/deactivate_dormant_users/export_result.sh"
  },
  "metadata": {
    "dormant_threshold_days": 90,
    "target_users": {
      "dormant_old": "dormant.old@helpdesk.local",
      "dormant_never": "dormant.never@helpdesk.local",
      "active_recent": "active.recent@helpdesk.local",
      "active_borderline": "active.borderline@helpdesk.local"
    }
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_deactivate_dormant_users"
    }
  }
}