{
  "id": "allergy_drug_conflict_resolution@1",
  "version": "1.0",
  "env_id": "nosh_env@0.1",
  "description": "A medication safety audit has flagged potential allergy-drug conflicts in your patient panel. Review the allergy records and active medication lists for all patients, identify those with documented drug allergies that conflict with their current prescriptions, and for each such patient: (1) discontinue (mark as inactive) the contraindicated medication, (2) prescribe a safe alternative medication, and (3) create an encounter note documenting the clinical rationale. One patient has an allergy but no actual conflict — do not modify their medications. Credentials: admin / Admin1234!, practice: Hillside Family Medicine.",
  "difficulty": "very_hard",
  "init": {
    "timeout_sec": 1440,
    "max_steps": 140,
    "reward_type": "dense"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/allergy_drug_conflict_resolution/setup_task.sh",
    "post_task": "/workspace/tasks/allergy_drug_conflict_resolution/export_result.sh"
  },
  "metadata": {
    "conflict_patients": [
      {
        "pid": 32,
        "name": "Marcus Odom",
        "dob": "1972-04-15",
        "allergy": "Sulfonamides",
        "conflicting_rx": "Trimethoprim-Sulfamethoxazole",
        "conflict_reason": "TMP-SMX contains a sulfonamide antibiotic"
      },
      {
        "pid": 33,
        "name": "Patricia Fenn",
        "dob": "1965-09-28",
        "allergy": "Penicillin",
        "conflicting_rx": "Amoxicillin",
        "conflict_reason": "Amoxicillin is a penicillin-type antibiotic"
      },
      {
        "pid": 34,
        "name": "Theodore Ashe",
        "dob": "1980-02-14",
        "allergy": "Codeine",
        "conflicting_rx": "Codeine Phosphate",
        "conflict_reason": "Direct allergy to codeine"
      }
    ],
    "noise_patient": {
      "pid": 35,
      "name": "Nancy Briggs",
      "dob": "1970-07-03",
      "allergy": "Latex",
      "rx": "Metformin",
      "conflict": false
    },
    "pass_threshold": 60
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_allergy_drug_conflict_resolution"
    }
  }
}
