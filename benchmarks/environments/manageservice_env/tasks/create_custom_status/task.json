{
  "id": "create_custom_status@1",
  "version": "1.0",
  "env_id": "manageservice_env@0.1",
  "description": "Log in to ManageEngine ServiceDesk Plus (administrator/administrator) and create a new Request Status named 'Waiting for Vendor'. Configure this status to be of Status Type 'Pending' so that it pauses the SLA timer when selected.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_custom_status/setup_task.sh",
    "post_task": "/workspace/tasks/create_custom_status/export_result.sh",
    "pre_task_timeout": 600
  },
  "metadata": {
    "target_status_name": "Waiting for Vendor",
    "target_status_type": "PENDING"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_custom_status"
    }
  }
}