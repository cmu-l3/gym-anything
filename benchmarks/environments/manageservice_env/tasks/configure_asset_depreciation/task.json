{
  "id": "configure_asset_depreciation@1",
  "version": "1.0",
  "env_id": "manageservice_env@0.1",
  "description": "Configure the asset depreciation policy for the 'Workstation' product type in ManageEngine ServiceDesk Plus. Navigate to Admin > Asset Management > Product Types (or Depreciation config). Set the depreciation method to 'Straight Line', Useful Life to '36' months (3 years), and Salvage Value to '5'%. Login credentials: administrator / administrator.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_asset_depreciation/setup_task.sh",
    "post_task": "/workspace/tasks/configure_asset_depreciation/export_result.sh",
    "pre_task_timeout": 600
  },
  "metadata": {
    "target_product": "Workstation",
    "expected_method": "Straight Line",
    "expected_useful_life": 36,
    "expected_salvage_value": 5,
    "scoring": {
      "policy_exists": 40,
      "correct_method": 20,
      "correct_life": 20,
      "correct_salvage": 20
    }
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_asset_depreciation"
    }
  }
}