{
  "id": "create_custom_ci_type@1",
  "version": "1.0",
  "env_id": "manageservice_env@0.1",
  "description": "Create a new CI Type in the CMDB named 'Delivery Drone' under the 'Assets' (or IT/Non-IT Assets) hierarchy. Add two specific attributes to this new type: 'Max Range' (Text/Alphanumeric) and 'Battery Cycles' (Numeric/Integer).",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_custom_ci_type/setup_task.sh",
    "post_task": "/workspace/tasks/create_custom_ci_type/export_result.sh",
    "pre_task_timeout": 600
  },
  "metadata": {
    "target_ci_type": "Delivery Drone",
    "target_attributes": [
      {
        "name": "Max Range",
        "type_keywords": ["CHAR", "TEXT", "STRING", "ALPHA"]
      },
      {
        "name": "Battery Cycles",
        "type_keywords": ["INT", "BIGINT", "NUMERIC", "LONG", "DECIMAL"]
      }
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_custom_ci_type"
    }
  }
}