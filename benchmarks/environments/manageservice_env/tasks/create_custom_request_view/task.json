{
  "id": "create_custom_request_view@1",
  "version": "1.0",
  "env_id": "manageservice_env@0.1",
  "description": "Create a new Custom View in the Requests module named 'Critical Unassigned Triage'. Configure the view to filter for tickets that match ALL of the following criteria: Priority is 'High', Technician is 'Unassigned' (or empty), and Status is 'Open'. Make the view public if the option exists.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_custom_request_view/setup_task.sh",
    "post_task": "/workspace/tasks/create_custom_request_view/export_result.sh",
    "pre_task_timeout": 600
  },
  "metadata": {
    "view_name": "Critical Unassigned Triage",
    "expected_criteria": {
      "priority": "High",
      "status": "Open",
      "technician": "null"
    }
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_custom_request_view"
    }
  }
}