{
  "id": "register_prohibited_software@1",
  "version": "1.0",
  "env_id": "manageservice_env@0.1",
  "description": "Register 'uTorrent' (Version 3.0, Manufacturer: BitTorrent Inc) and 'Steam' (Latest version, Manufacturer: Valve Corporation) in the ServiceDesk Plus software repository. Classify both as 'Prohibited' software type. Finally, enable the notification rule to alert technicians when prohibited software is detected. Start by logging in with administrator / administrator.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/register_prohibited_software/setup_task.sh",
    "post_task": "/workspace/tasks/register_prohibited_software/export_result.sh",
    "pre_task_timeout": 600
  },
  "metadata": {
    "software_targets": [
      {
        "name": "uTorrent",
        "manufacturer": "BitTorrent Inc",
        "version_check": "3.0"
      },
      {
        "name": "Steam",
        "manufacturer": "Valve Corporation",
        "version_check": "Latest"
      }
    ],
    "required_type": "Prohibited",
    "notification_rule_keyword": "prohibited"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_register_prohibited_software"
    }
  }
}