{
  "id": "configure_operational_hours@1",
  "version": "1.0",
  "env_id": "manageservice_env@0.1",
  "description": "Configure the Operational Hours (Business Hours) for the help desk. Navigate to Admin > Operational Hours (or Helpdesk Customizer) and set the schedule as follows: Monday through Friday: 08:00 to 18:00. Saturday: 09:00 to 13:00. Sunday: Not operational (closed). Save the configuration.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_operational_hours/setup_task.sh",
    "post_task": "/workspace/tasks/configure_operational_hours/export_result.sh",
    "pre_task_timeout": 3600
  },
  "metadata": {
    "target_schedule": {
      "Mon": {"start": "08:00", "end": "18:00", "active": true},
      "Tue": {"start": "08:00", "end": "18:00", "active": true},
      "Wed": {"start": "08:00", "end": "18:00", "active": true},
      "Thu": {"start": "08:00", "end": "18:00", "active": true},
      "Fri": {"start": "08:00", "end": "18:00", "active": true},
      "Sat": {"start": "09:00", "end": "13:00", "active": true},
      "Sun": {"active": false}
    }
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_operational_hours"
    }
  }
}