{
  "id": "configure_auto_signout@1",
  "version": "1.0",
  "env_id": "jolly_lobby_track_env@0.1",
  "description": "Navigate to the Administration or Settings menu in Jolly Lobby Track. Locate the 'Auto Sign Out' or 'Automatic Check Out' feature for visitors. Enable this feature and configure the timer duration to exactly 8 hours (or 480 minutes). Save the changes to ensure visitors are automatically signed out if they forget to check out.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_auto_signout/setup_task.sh",
    "post_task": "/workspace/tasks/configure_auto_signout/export_result.sh"
  },
  "metadata": {
    "target_hours": 8,
    "target_minutes": 480,
    "setting_keywords": ["Auto", "Sign Out", "Checkout", "Timer"],
    "expected_ui_text": ["8 hours", "480 minutes", "8:00"],
    "config_locations": [
      "/home/ga/.wine/drive_c/ProgramData/Jolly Technologies",
      "/home/ga/.wine/drive_c/users/ga/Local Settings/Application Data/Jolly_Technologies",
      "/home/ga/.wine/drive_c/Program Files/Jolly Technologies/Lobby Track"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_auto_signout"
    }
  }
}