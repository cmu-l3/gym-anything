{
  "id": "record_network_stream@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Record a network video stream to a local file using VLC's convert/save feature",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/record_network_stream/setup_task.sh",
    "post_task": "/workspace/tasks/record_network_stream/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_recording"
    }
  }
}