{
  "id": "clear_playback_history@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Clear all VLC playback history including recent files and media library for privacy on a shared device",
  "difficulty": "easy-medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_playback_history/setup_task.sh",
    "post_task": "/workspace/tasks/clear_playback_history/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_clear_playback_history"
    }
  }
}