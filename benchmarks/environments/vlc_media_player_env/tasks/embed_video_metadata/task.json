{
  "id": "embed_video_metadata@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Edit and embed metadata (title, artist, description, copyright) into a video file using VLC's Media Information editor",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/embed_video_metadata/setup_task.sh",
    "post_task": "/workspace/tasks/embed_video_metadata/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_embed_video_metadata"
    }
  }
}