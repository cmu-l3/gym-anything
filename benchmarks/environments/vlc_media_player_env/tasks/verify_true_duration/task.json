{
  "id": "verify_true_duration@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Determine the true playable duration of a video file with corrupted metadata claiming longer duration than actual content",
  "category": "technical_diagnostics",
  "difficulty": "medium",
  "tags": ["vlc", "video", "metadata", "diagnostics", "troubleshooting", "file-integrity"],
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_true_duration/setup_task.sh",
    "post_task": "/workspace/tasks/verify_true_duration/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_true_duration"
    }
  }
}