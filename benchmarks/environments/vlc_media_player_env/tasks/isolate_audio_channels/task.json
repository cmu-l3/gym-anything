{
  "id": "isolate_audio_channels@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to isolate and test individual audio channels for troubleshooting surround sound speaker connections",
  "difficulty": "medium",
  "tags": ["audio", "surround-sound", "troubleshooting", "configuration", "diagnostics"],
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/isolate_audio_channels/setup_task.sh",
    "post_task": "/workspace/tasks/isolate_audio_channels/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_isolate_audio_channels"
    }
  }
}