{
  "id": "auto_stop_sleep_timer@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to automatically stop and quit after 45 seconds for sleep timer functionality",
  "difficulty": "medium",
  "tags": ["vlc", "automation", "scheduling", "sleep-timer", "battery-saving", "command-line"],
  "init": {
    "timeout_sec": 75,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/auto_stop_sleep_timer/setup_task.sh",
    "post_task": "/workspace/tasks/auto_stop_sleep_timer/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_sleep_timer"
    }
  },
  "metadata": {
    "scenario": "sleep_timer",
    "target_runtime_sec": 45,
    "tolerance_sec": 10,
    "requires_clean_exit": true
  }
}