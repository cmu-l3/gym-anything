{
  "id": "adjust_audio_balance@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Adjust VLC audio balance to strongly favor left channel (simulating broken right earphone scenario)",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/adjust_audio_balance/setup_task.sh",
    "post_task": "/workspace/tasks/adjust_audio_balance/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_adjust_audio_balance"
    }
  }
}