{
  "id": "configure_projector_output@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to output video at projector's native resolution (1280x800) for smooth presentation playback",
  "difficulty": "medium",
  "tags": ["vlc", "configuration", "video-output", "resolution", "projector", "presentation"],
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_projector_output/setup_task.sh",
    "post_task": "/workspace/tasks/configure_projector_output/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_projector_output_config"
    }
  }
}