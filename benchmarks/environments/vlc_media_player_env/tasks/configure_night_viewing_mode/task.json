{
  "id": "configure_night_viewing_mode@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC with persistent night viewing mode (reduced brightness and warm colors for dark room viewing)",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_night_viewing_mode/setup_task.sh",
    "post_task": "/workspace/tasks/configure_night_viewing_mode/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_night_viewing_mode"
    }
  }
}