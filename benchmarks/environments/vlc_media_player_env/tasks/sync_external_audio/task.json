{
  "id": "sync_external_audio@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Load external audio file and synchronize it with video playback",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/sync_external_audio/setup_task.sh",
    "post_task": "/workspace/tasks/sync_external_audio/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_sync_external_audio"
    }
  }
}