{
  "id": "configure_asl_practice@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC for American Sign Language (ASL) practice workflow with slow playback, frame-step hotkeys, and bookmarks",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_asl_practice/setup_task.sh",
    "post_task": "/workspace/tasks/configure_asl_practice/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_asl_practice_config"
    }
  }
}