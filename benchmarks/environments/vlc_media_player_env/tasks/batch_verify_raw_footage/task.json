{
  "id": "batch_verify_raw_footage@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Systematically verify a batch of raw video files for quality assurance and create a comprehensive QA report",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/batch_verify_raw_footage/setup_task.sh",
    "post_task": "/workspace/tasks/batch_verify_raw_footage/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_batch_verify_raw_footage"
    }
  }
}