{
  "id": "bookmark_study_scenes@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Create custom bookmarks at key timestamps in an educational video for study navigation",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_study_scenes/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_study_scenes/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_bookmark_study_scenes"
    }
  }
}