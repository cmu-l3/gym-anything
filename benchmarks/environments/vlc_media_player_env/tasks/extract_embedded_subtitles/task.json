{
  "id": "extract_embedded_subtitles@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract embedded English subtitle track from multi-language video container as standalone SRT file",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_embedded_subtitles/setup_task.sh",
    "post_task": "/workspace/tasks/extract_embedded_subtitles/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_subtitles"
    }
  }
}