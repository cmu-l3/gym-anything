{
  "id": "burn_subtitles_permanent@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Permanently burn subtitles into video frames for universal device compatibility",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/burn_subtitles_permanent/setup_task.sh",
    "post_task": "/workspace/tasks/burn_subtitles_permanent/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_burn_subtitles"
    }
  }
}