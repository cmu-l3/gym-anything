{
  "id": "capture_stream_test@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Verify network stream and record a test segment to confirm audio/video quality",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/capture_stream_test/setup_task.sh",
    "post_task": "/workspace/tasks/capture_stream_test/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_capture_stream_test"
    }
  }
}