{
  "id": "configure_pip_mode@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC in always-on-top picture-in-picture mode for multitasking workflows",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_pip_mode/setup_task.sh",
    "post_task": "/workspace/tasks/configure_pip_mode/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_pip_mode"
    }
  }
}