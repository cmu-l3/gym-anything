{
  "id": "verify_delivery_specs@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Inspect a delivered video file and verify it meets technical specifications",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_delivery_specs/setup_task.sh",
    "post_task": "/workspace/tasks/verify_delivery_specs/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_delivery_specs"
    }
  }
}