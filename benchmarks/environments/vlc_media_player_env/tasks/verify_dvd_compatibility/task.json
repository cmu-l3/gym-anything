{
  "id": "verify_dvd_compatibility@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Analyze video file and create DVD compatibility report with pass/fail assessment",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_dvd_compatibility/setup_task.sh",
    "post_task": "/workspace/tasks/verify_dvd_compatibility/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_dvd_compatibility"
    }
  }
}