{
  "id": "take_snapshot@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Capture a snapshot at a specific timestamp in a video",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/take_snapshot/setup_task.sh",
    "post_task": "/workspace/tasks/take_snapshot/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_take_snapshot"
    }
  }
}
