{
  "id": "deinterlace_vhs_footage@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Enable deinterlacing in VLC to fix interlacing artifacts in digitized VHS footage",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/deinterlace_vhs_footage/setup_task.sh",
    "post_task": "/workspace/tasks/deinterlace_vhs_footage/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_deinterlace_vhs_footage"
    }
  }
}