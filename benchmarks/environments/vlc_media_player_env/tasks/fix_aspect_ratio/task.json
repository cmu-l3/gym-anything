{
  "id": "fix_aspect_ratio@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Fix the display aspect ratio of a 4:3 video that appears stretched in widescreen format",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/fix_aspect_ratio/setup_task.sh",
    "post_task": "/workspace/tasks/fix_aspect_ratio/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_fix_aspect_ratio"
    }
  }
}