{
  "id": "export_playback_history@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Export VLC's playback history to a CSV file for parental monitoring",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/export_playback_history/setup_task.sh",
    "post_task": "/workspace/tasks/export_playback_history/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_export_playback_history"
    }
  }
}