{
  "id": "verify_backup_integrity@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Verify that a backup copy of a video file is complete and uncorrupted before deleting the original",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_backup_integrity/setup_task.sh",
    "post_task": "/workspace/tasks/verify_backup_integrity/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_backup_integrity"
    }
  }
}