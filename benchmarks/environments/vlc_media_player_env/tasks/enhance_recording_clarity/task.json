{
  "id": "enhance_recording_clarity@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Enhance a noisy audio recording to improve speech intelligibility using VLC's audio filters",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/enhance_recording_clarity/setup_task.sh",
    "post_task": "/workspace/tasks/enhance_recording_clarity/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_enhance_recording_clarity"
    }
  }
}