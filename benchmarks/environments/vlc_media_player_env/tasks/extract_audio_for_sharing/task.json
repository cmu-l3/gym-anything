{
  "id": "extract_audio_for_sharing@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract audio from a video recording and save as MP3 for easy sharing",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_audio_for_sharing/setup_task.sh",
    "post_task": "/workspace/tasks/extract_audio_for_sharing/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_audio_for_sharing"
    }
  },
  "tags": ["audio", "conversion", "extraction", "mp3", "file-management", "sharing"],
  "category": "media_conversion"
}