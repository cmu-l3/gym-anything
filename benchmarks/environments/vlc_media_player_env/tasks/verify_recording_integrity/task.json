{
  "id": "verify_recording_integrity@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Verify a screen recording has correct specifications and identify audio capture issues before editing",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_recording_integrity/setup_task.sh",
    "post_task": "/workspace/tasks/verify_recording_integrity/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_recording_integrity"
    }
  }
}