{
  "id": "configure_audio_output_device@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to output audio to a specific non-default device (HDMI) instead of system default",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_audio_output_device/setup_task.sh",
    "post_task": "/workspace/tasks/configure_audio_output_device/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_audio_device_configuration"
    }
  }
}