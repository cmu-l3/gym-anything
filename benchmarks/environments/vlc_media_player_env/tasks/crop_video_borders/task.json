{
  "id": "crop_video_borders@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Crop unwanted borders from a video by removing specific pixel amounts from all four sides",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/crop_video_borders/setup_task.sh",
    "post_task": "/workspace/tasks/crop_video_borders/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_crop_video_borders"
    }
  }
}