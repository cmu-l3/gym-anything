{
  "id": "switch_audio_output_device@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Switch VLC's audio output device to Reference_Headphones while audio is playing",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/switch_audio_output_device/setup_task.sh",
    "post_task": "/workspace/tasks/switch_audio_output_device/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_switch_audio_output_device"
    }
  }
}