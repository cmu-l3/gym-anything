{
  "id": "fix_portrait_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Convert portrait-mode video (9:16) to landscape format (16:9) using VLC's conversion and geometric transformation",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/fix_portrait_video/setup_task.sh",
    "post_task": "/workspace/tasks/fix_portrait_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_fix_portrait_video"
    }
  }
}