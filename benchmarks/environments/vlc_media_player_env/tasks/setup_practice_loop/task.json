{
  "id": "setup_practice_loop@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC A-B repeat loop with slowed playback and pitch preservation for music practice",
  "difficulty": "medium",
  "tags": ["vlc", "audio", "practice", "loop", "musician", "transcription", "pitch-preservation", "a-b-repeat"],
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/setup_practice_loop/setup_task.sh",
    "post_task": "/workspace/tasks/setup_practice_loop/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_practice_loop"
    }
  }
}