{
  "id": "rotate_phone_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Rotate a sideways phone video to correct orientation using VLC's transform filters",
  "tags": ["vlc", "video", "rotation", "transform", "filters", "geometry"],
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/rotate_phone_video/setup_task.sh",
    "post_task": "/workspace/tasks/rotate_phone_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_rotate_phone_video"
    }
  }
}