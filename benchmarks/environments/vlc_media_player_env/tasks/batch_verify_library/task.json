{
  "id": "batch_verify_library@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Create a playlist from archive folder videos and save for verification documentation",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/batch_verify_library/setup_task.sh",
    "post_task": "/workspace/tasks/batch_verify_library/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_batch_verify_library"
    }
  }
}