{
  "id": "clear_media_history@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Clear VLC's recently played media history to protect privacy",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_media_history/setup_task.sh",
    "post_task": "/workspace/tasks/clear_media_history/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_clear_media_history"
    }
  }
}