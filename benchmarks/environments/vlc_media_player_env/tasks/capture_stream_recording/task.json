{
  "id": "capture_stream_recording@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Record a network stream to a local file using VLC's streaming output",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/capture_stream_recording/setup_task.sh",
    "post_task": "/workspace/tasks/capture_stream_recording/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_capture_stream_recording"
    }
  }
}