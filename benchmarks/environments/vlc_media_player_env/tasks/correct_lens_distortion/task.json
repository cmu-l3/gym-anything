{
  "id": "correct_lens_distortion@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Apply VLC geometry filters to correct barrel/fisheye distortion and capture corrected snapshot",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/correct_lens_distortion/setup_task.sh",
    "post_task": "/workspace/tasks/correct_lens_distortion/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_correct_lens_distortion"
    }
  }
}