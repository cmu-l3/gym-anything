{
  "id": "resume_position_recovery@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to remember and resume playback position for a long documentary video",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/resume_position_recovery/setup_task.sh",
    "post_task": "/workspace/tasks/resume_position_recovery/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_resume_position"
    }
  }
}