{
  "id": "stabilize_shaky_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Enable VLC's video stabilization filter to watch shaky footage with motion smoothing",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/stabilize_shaky_video/setup_task.sh",
    "post_task": "/workspace/tasks/stabilize_shaky_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_stabilize_shaky_video"
    }
  }
}