{
  "id": "navigate_chapter_markers@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Navigate a long documentary using chapter markers to reach specific chapters and capture snapshots",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/navigate_chapter_markers/setup_task.sh",
    "post_task": "/workspace/tasks/navigate_chapter_markers/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_navigate_chapter_markers"
    }
  }
}