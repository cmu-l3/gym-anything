{
  "id": "test_capture_devices@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Record a brief test video from capture devices to verify A/V equipment functionality",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/test_capture_devices/setup_task.sh",
    "post_task": "/workspace/tasks/test_capture_devices/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_test_capture_devices"
    }
  }
}