{
  "id": "log_evidence_timestamps@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Review evidence footage and create a precise timestamp log of key events",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/log_evidence_timestamps/setup_task.sh",
    "post_task": "/workspace/tasks/log_evidence_timestamps/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_log_evidence_timestamps"
    }
  }
}