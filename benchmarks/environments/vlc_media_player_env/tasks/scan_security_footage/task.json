{
  "id": "scan_security_footage@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Scan long security footage to locate and document a suspicious incident using fast playback and snapshot capture",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/scan_security_footage/setup_task.sh",
    "post_task": "/workspace/tasks/scan_security_footage/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_scan_security_footage"
    }
  }
}