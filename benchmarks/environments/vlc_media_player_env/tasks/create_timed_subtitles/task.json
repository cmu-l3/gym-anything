{
  "id": "create_timed_subtitles@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Create properly-timed SRT subtitle file for a tutorial video",
  "difficulty": "medium",
  "tags": ["subtitles", "srt", "timing", "accessibility", "content-creation"],
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_timed_subtitles/setup_task.sh",
    "post_task": "/workspace/tasks/create_timed_subtitles/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_timed_subtitles"
    }
  }
}