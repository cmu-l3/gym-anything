{
  "id": "verify_partial_download@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Analyze a partially downloaded video to determine playable duration and document findings",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_partial_download/setup_task.sh",
    "post_task": "/workspace/tasks/verify_partial_download/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_partial_download"
    }
  }
}