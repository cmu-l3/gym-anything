{
  "id": "normalize_podcast_audio@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Normalize three podcast audio segments with inconsistent volumes to have uniform peak levels",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/normalize_podcast_audio/setup_task.sh",
    "post_task": "/workspace/tasks/normalize_podcast_audio/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_normalize_podcast_audio"
    }
  }
}