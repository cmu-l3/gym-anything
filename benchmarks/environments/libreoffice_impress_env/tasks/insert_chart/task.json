{
  "id": "insert_chart@1",
  "version": "1.0",
  "env_id": "libreoffice_impress_env@0.1",
  "description": "Insert a chart on a slide using provided data and format it appropriately",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/insert_chart/setup_task.sh",
    "post_task": "/workspace/tasks/insert_chart/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_chart_inserted"
    }
  }
}
