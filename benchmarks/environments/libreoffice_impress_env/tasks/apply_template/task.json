{
  "id": "apply_template@1",
  "version": "1.0",
  "env_id": "libreoffice_impress_env@0.1",
  "description": "Apply a specific template/theme to an existing presentation to change its visual appearance",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/apply_template/setup_task.sh",
    "post_task": "/workspace/tasks/apply_template/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_template_applied"
    }
  }
}
