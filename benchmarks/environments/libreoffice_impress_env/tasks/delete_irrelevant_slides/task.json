{
  "id": "delete_irrelevant_slides@1",
  "version": "1.0",
  "env_id": "libreoffice_impress_env@0.1",
  "description": "You have a 10-slide Business Impact Analysis presentation open in LibreOffice Impress. Your task is to delete three specific slides that are not relevant to your department and save the file.\n\nSlides to delete:\n1. \"IT Infrastructure Assessment\" (currently Slide 3)\n2. \"Supply Chain Dependencies\" (currently Slide 6)\n3. \"Vendor Management\" (currently Slide 9)\n\nAfter deleting these three slides, exactly 7 slides should remain. Save the changes to the file (Ctrl+S).",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/delete_irrelevant_slides/setup_task.sh",
    "post_task": "/workspace/tasks/delete_irrelevant_slides/export_result.sh"
  },
  "metadata": {
    "target_file_pptx": "/home/ga/Documents/Presentations/bia_report.pptx",
    "target_file_odp": "/home/ga/Documents/Presentations/bia_report.odp",
    "expected_slide_count": 7,
    "deleted_titles": [
      "IT Infrastructure Assessment",
      "Supply Chain Dependencies",
      "Vendor Management"
    ],
    "retained_titles": [
      "Business Impact Analysis Report",
      "Executive Summary",
      "Critical Business Functions",
      "Risk Assessment Matrix",
      "Recovery Time Objectives",
      "Communication Plan",
      "Action Items and Next Steps"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_delete_slides"
    }
  }
}