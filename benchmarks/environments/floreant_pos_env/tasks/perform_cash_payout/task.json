{
  "id": "perform_cash_payout@1",
  "version": "1.0",
  "env_id": "floreant_pos_env@0.1",
  "description": "Record a cash payout (Petty Cash) transaction. The bar needs to buy emergency supplies. \n\n1. Go to the MANAGER menu.\n2. Use PIN 1111 if prompted.\n3. Select 'PAY OUT'.\n4. Enter the amount: $12.50.\n5. Enter the reason: 'Emergency Limes'.\n6. Save the transaction.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/perform_cash_payout/setup_task.sh",
    "post_task": "/workspace/tasks/perform_cash_payout/export_result.sh"
  },
  "metadata": {
    "expected_amount": 12.50,
    "expected_reason": "Emergency Limes",
    "manager_pin": "1111",
    "transaction_type": "PAY_OUT"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_perform_cash_payout"
    }
  }
}