{
  "id": "plant_propagation_success@1",
  "version": "1.0",
  "env_id": "libreoffice_calc_env@0.1",
  "description": "Analyze messy houseplant propagation data to calculate success rates by method and plant type, identify fastest-rooting combinations, and create actionable insights with conditional formatting.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/plant_propagation_success/setup_task.sh",
    "post_task": "/workspace/tasks/plant_propagation_success/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_propagation_analysis"
    }
  }
}