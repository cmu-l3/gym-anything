{
  "id": "mileage_deduction@1",
  "version": "1.0",
  "env_id": "libreoffice_calc_env@0.1",
  "description": "Calculate tax-deductible mileage by adding formulas for trip deductions (Miles × Rate) and totals using SUM functions. Real-world business scenario for freelance consultants.",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 120,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/mileage_deduction/setup_task.sh",
    "post_task": "/workspace/tasks/mileage_deduction/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_mileage_deduction"
    }
  }
}