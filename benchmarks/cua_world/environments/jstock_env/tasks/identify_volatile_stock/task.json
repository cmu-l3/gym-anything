{
  "id": "identify_volatile_stock@1",
  "version": "1.0",
  "env_id": "jstock_env@0.1",
  "description": "Analyze the intraday price data for stocks in 'My Watchlist'. For each stock, calculate the volatility percentage using the formula `(High - Low) / Last Price`. Identify the stock symbol with the highest volatility percentage. Create a file named `most_volatile_stock.txt` in the home directory (`/home/ga/`) and write the symbol of the winning stock (e.g., 'AMD') into that file.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/identify_volatile_stock/setup_task.sh",
    "post_task": "/workspace/tasks/identify_volatile_stock/export_result.sh"
  },
  "metadata": {
    "expected_symbol": "AMD",
    "output_file": "/home/ga/most_volatile_stock.txt",
