{
  "id": "configure_market_analyzer_rsi_alerts@1",
  "version": "1.0",
  "env_id": "ninja_trader_env@0.1",
  "description": "Create a Market Analyzer window in NinjaTrader 8 for instruments SPY, AAPL, and MSFT. Configure the 'RSI' (Period 14) column with conditional formatting: set the cell background color to Red if the value is Greater than 70, and Green if the value is Less than 30. Save the workspace when finished.",
  "difficulty": "hard",
  "init": {
    "timeout_sec": 480,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "powershell -ExecutionPolicy Bypass -File C:\\workspace\\tasks\\configure_market_analyzer_rsi_alerts\\setup_task.ps1",
    "post_task": "powershell -ExecutionPolicy Bypass -File C:\\workspace\\tasks\\configure_market_analyzer_rsi_alerts\\export_result.ps1"
  },
  "metadata": {
    "instruments": ["SPY", "AAPL", "MSFT"],
    "indicator": "RSI",
    "conditions": [
      {
        "op": "Greater",
        "val": 70,
        "color": "Red"
      },
      {
        "op": "Less",
        "val": 30,
        "color": "Green"
      }
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_market_analyzer_rsi_alerts"
    }
  }
}