{
  "id": "format_planetary_image_grid@1",
  "version": "1.0",
  "env_id": "libreoffice_impress_env@0.1",
  "description": "Create a new slide containing 4 specific planetary images (Earth, Moon, Mars, Jupiter) located in '~/Documents/SpaceImages/'. Resize each image to exactly 5.0 cm x 5.0 cm. Arrange them in a 2x2 grid layout. Apply a 2pt blue solid border to each image. Save the presentation as '~/Documents/Presentations/solar_system_grid.odp'.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/format_planetary_image_grid/setup_task.sh",
    "post_task": "/workspace/tasks/format_planetary_image_grid/export_result.sh"
  },
  "metadata": {
    "image_dir": "/home/ga/Documents/SpaceImages",
    "output_path": "/home/ga/Documents/Presentations/solar_system_grid.odp",
    "expected_image_count": 4,
    "target_width_cm": 5.0,
    "target_height_cm": 5.0,
    "target_border_width_pt": 2.0,
    "tolerance_cm": 0.1,
    "images": ["earth.jpg", "moon.jpg", "mars.jpg", "jupiter.jpg"]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_planetary_grid"
    }
  }
}