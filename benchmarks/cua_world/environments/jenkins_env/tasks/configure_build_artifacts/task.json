{
  "id": "configure_build_artifacts@1",
  "version": "1.0",
  "env_id": "jenkins_env@0.1",
  "description": "Configure the existing freestyle job named 'Integration-Tests'. You need to: 1) Enable 'Discard old builds' to keep builds for 14 days and a maximum of 5 builds. 2) Add a 'Post-build action' to 'Archive the artifacts' targeting 'reports/*.xml, reports/*.html'. You are logged in as admin.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_build_artifacts/setup_task.sh",
    "post_task": "/workspace/tasks/configure_build_artifacts/export_result.sh",
    "pre_task_timeout": 120
  },
  "metadata": {
    "job_name": "Integration-Tests",
    "expected_days_to_keep": "14",
    "expected_num_to_keep": "5",
    "expected_artifacts": ["reports/*.xml", "reports/*.html"]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_build_artifacts"
    }
  }
}