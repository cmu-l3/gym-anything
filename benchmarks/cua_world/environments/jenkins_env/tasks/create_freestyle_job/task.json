{
  "id": "create_freestyle_job@1",
  "version": "1.0",
  "env_id": "jenkins_env@0.1",
  "description": "Create a new freestyle Jenkins job named 'HelloWorld-Build' that executes a simple shell command to echo 'Hello from Jenkins!'. You are already logged in as admin. If prompted to log in, use Username: admin, Password: Admin123!",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 180,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_freestyle_job/setup_task.sh",
    "post_task": "/workspace/tasks/create_freestyle_job/export_result.sh"
  },
  "metadata": {
    "expected_job_name": "HelloWorld-Build",
    "expected_command": "echo 'Hello from Jenkins!'"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_freestyle_job"
    }
  }
}
