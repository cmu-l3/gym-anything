{
  "id": "website_shortcut@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Create a desktop shortcut for Wikipedia using Chrome's 'Create shortcut' feature with 'Open as window' option enabled",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/website_shortcut/setup_task.sh",
    "post_task": "/workspace/tasks/website_shortcut/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}