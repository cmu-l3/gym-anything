{
  "id": "bookmarks_folder_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Organize bookmarks by creating a 'News' folder in the bookmark bar and moving news-related bookmarks into it while keeping tech bookmarks in the bar.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmarks_folder_organize/setup_bookmarks_task.sh",
    "post_task": "/workspace/tasks/bookmarks_folder_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}