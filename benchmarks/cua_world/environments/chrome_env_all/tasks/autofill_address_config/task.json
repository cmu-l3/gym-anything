{
  "id": "autofill_address_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome autofill by adding a complete address entry (name, organization, street, city, state, zip, country, phone, email) in Settings > Autofill and passwords > Addresses",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/autofill_address_config/setup_task.sh",
    "post_task": "/workspace/tasks/autofill_address_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}