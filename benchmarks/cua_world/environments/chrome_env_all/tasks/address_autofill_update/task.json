{
  "id": "address_autofill_update@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Update Chrome's autofill addresses by removing an outdated address (742 Evergreen Terrace) and adding a new current address (1640 Riverside Drive, Metropolis, NY 10001)",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/address_autofill_update/setup_autofill_task.sh",
    "post_task": "/workspace/tasks/address_autofill_update/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}