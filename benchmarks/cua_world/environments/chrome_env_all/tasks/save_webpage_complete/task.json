{
  "id": "save_webpage_complete@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Save a complete webpage with all resources (images, CSS, JavaScript) using Chrome's 'Save Page As' feature with 'Webpage, Complete' format.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/save_webpage_complete/setup_task.sh",
    "post_task": "/workspace/tasks/save_webpage_complete/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}