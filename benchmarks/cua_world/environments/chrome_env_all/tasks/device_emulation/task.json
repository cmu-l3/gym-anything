{
  "id": "device_emulation@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Open Chrome DevTools and enable device emulation for iPhone 12 Pro to test responsive design. The viewport should be set to 390x844 pixels.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/device_emulation/setup_task.sh",
    "post_task": "/workspace/tasks/device_emulation/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}