{
  "id": "media_autoplay_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Configure Chrome's media autoplay settings to block autoplay on news.example.com by navigating to Site Settings and adding the domain to the sound/autoplay block list.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/media_autoplay_config/setup_task.sh",
    "post_task": "/workspace/tasks/media_autoplay_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}