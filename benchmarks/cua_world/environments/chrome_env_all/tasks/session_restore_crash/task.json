{
  "id": "session_restore_crash@1",
  "version": "1.0",
  "env_id": "chrome_env_all@0.1",
  "description": "Recover a browsing session after Chrome crash by using the Restore prompt or History menu to restore all previously open tabs",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/session_restore_crash/setup_crash_scenario.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}