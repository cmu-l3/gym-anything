{
  "id": "javascript_block_site@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to block JavaScript on a specific test website by adding a site-specific exception in Settings → Privacy and security → Site Settings → JavaScript",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/javascript_block_site/setup_task.sh",
    "post_task": "/workspace/tasks/javascript_block_site/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}