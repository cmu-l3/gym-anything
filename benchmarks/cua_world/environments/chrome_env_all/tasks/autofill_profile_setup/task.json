{
  "id": "autofill_profile_setup@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Configure Chrome autofill profile with personal information (name, email, phone, address) to save time on future form filling",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/autofill_profile_setup/setup_task.sh",
    "post_task": "/workspace/tasks/autofill_profile_setup/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}