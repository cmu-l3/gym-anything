{
  "id": "pwa_install@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Install a Progressive Web App (PWA) from a website and configure it to open as a standalone window application",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/pwa_install/setup_task.sh",
    "post_task": "/workspace/tasks/pwa_install/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}