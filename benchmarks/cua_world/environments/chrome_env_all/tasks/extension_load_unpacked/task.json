{
  "id": "extension_load_unpacked@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Load an unpacked Chrome extension in developer mode. Navigate to chrome://extensions, enable developer mode, and load the test extension from /home/ga/test_extension/",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extension_load_unpacked/setup_task.sh",
    "post_task": "/workspace/tasks/extension_load_unpacked/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}