{
  "id": "tab_groups_organization@1",
  "version": "1.0",
  "env_id": "chrome_env_all",
  "description": "Organize 12 open tabs into 4 logical tab groups (News, Shopping, Documentation, Social) with appropriate names and colors",
  "init": {
    "timeout_sec": 180,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_groups_organization/setup_task.sh",
    "post_task": "/workspace/tasks/tab_groups_organization/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}