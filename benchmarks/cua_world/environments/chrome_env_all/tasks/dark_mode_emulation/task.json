{
  "id": "dark_mode_emulation@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome DevTools Rendering panel to enable dark mode emulation (prefers-color-scheme: dark) to test webpage dark mode styling",
  "init": {
    "timeout_sec": 90,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/dark_mode_emulation/setup_task.sh",
    "post_task": "/workspace/tasks/dark_mode_emulation/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}