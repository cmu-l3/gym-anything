{
  "id": "spellcheck_custom_dictionary@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Configure Chrome's spell check system for English and add custom words to the dictionary through contextual interaction",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/spellcheck_custom_dictionary/setup_task.sh",
    "post_task": "/workspace/tasks/spellcheck_custom_dictionary/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}