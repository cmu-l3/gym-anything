{
  "id": "clear_browsing_history@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Clear all browsing history using Chrome's privacy settings while preserving cookies and other data types",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_browsing_history/setup_task.sh",
    "post_task": "/workspace/tasks/clear_browsing_history/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}