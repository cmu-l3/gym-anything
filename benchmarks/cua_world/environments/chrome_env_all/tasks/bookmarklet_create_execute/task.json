{
  "id": "bookmarklet_create_execute@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Create a bookmarklet that changes webpage background to bright red, then execute it to verify functionality",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmarklet_create_execute/setup_task.sh",
    "post_task": "/workspace/tasks/bookmarklet_create_execute/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}