{
  "id": "cookie_privacy_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to block third-party cookies for enhanced privacy by navigating to Settings > Privacy and security > Third-party cookies and enabling blocking.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/cookie_privacy_config/setup_task.sh",
    "post_task": "/workspace/tasks/cookie_privacy_config/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}