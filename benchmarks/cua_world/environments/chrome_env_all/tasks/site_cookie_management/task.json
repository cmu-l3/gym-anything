{
  "id": "site_cookie_management@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to Chrome's site data settings, search for github.com, and selectively clear its cookies without affecting other sites",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/site_cookie_management/setup_task.sh",
    "post_task": "/workspace/tasks/site_cookie_management/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}