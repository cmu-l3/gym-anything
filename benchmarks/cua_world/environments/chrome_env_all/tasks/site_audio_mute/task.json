{
  "id": "site_audio_mute@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to YouTube and configure site-specific audio muting to permanently silence all audio from that site while preserving audio functionality on other sites.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "config": {
    "target_site": "youtube.com",
    "target_url": "https://www.youtube.com"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/site_audio_mute/setup_task.sh",
    "post_task": "/workspace/tasks/site_audio_mute/close_chrome.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}