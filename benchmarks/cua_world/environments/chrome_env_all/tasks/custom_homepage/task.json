{
  "id": "custom_homepage@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome's homepage by enabling the home button and setting a custom homepage URL (https://en.wikipedia.org), then verify by navigating to the homepage",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/custom_homepage/setup_task.sh",
    "post_task": "/workspace/tasks/custom_homepage/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}