{
  "id": "tab_duplicate@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to example.com and duplicate the tab to create two identical tabs with the same URL",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_duplicate/setup_task.sh",
    "post_task": "/workspace/tasks/tab_duplicate/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}