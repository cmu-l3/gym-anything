{
  "id": "page_zoom_accessibility@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Increase Chrome's page zoom to 125-150% for better readability on a Wikipedia article using keyboard shortcuts (Ctrl++) or menu-based zoom controls",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/page_zoom_accessibility/setup_task.sh",
    "post_task": "/workspace/tasks/page_zoom_accessibility/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}