{
  "id": "notification_permission_control@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to a notification test page, grant notification permission when prompted, then revoke it through Chrome's site settings",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/notification_permission_control/setup_task.sh",
    "post_task": "/workspace/tasks/notification_permission_control/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}