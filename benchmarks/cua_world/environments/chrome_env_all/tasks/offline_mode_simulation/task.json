{
  "id": "offline_mode_simulation@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome DevTools Network panel to simulate offline mode, observe offline error page, then restore connectivity and verify page loads successfully",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/offline_mode_simulation/setup_task.sh",
    "post_task": "/workspace/tasks/offline_mode_simulation/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}