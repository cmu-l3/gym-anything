{
  "id": "multi_tab_session@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Open a multi-tab research session by creating 4 tabs with specific URLs: Wikipedia, GitHub, Stack Overflow, and MDN Web Docs.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/multi_tab_session/setup_task.sh",
    "post_task": "/workspace/tasks/multi_tab_session/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}