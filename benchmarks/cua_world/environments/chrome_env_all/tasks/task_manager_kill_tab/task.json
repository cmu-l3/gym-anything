{
  "id": "task_manager_kill_tab@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's Task Manager to identify and terminate the GitHub tab process while preserving other tabs (example.com, wikipedia.org, stackoverflow.com)",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/task_manager_kill_tab/setup_task.sh",
    "post_task": "/workspace/tasks/task_manager_kill_tab/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}