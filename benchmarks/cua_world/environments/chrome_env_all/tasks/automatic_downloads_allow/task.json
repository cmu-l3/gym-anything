{
  "id": "automatic_downloads_allow@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to allow automatic downloads from a specific website (https://download-test.example.com) by navigating to Settings > Privacy and security > Site Settings > Automatic downloads and adding the site to the allowed list",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/automatic_downloads_allow/setup_task.sh",
    "post_task": "/workspace/tasks/automatic_downloads_allow/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  },
  "metadata": {
    "target_site": "https://download-test.example.com",
    "difficulty": "medium",
    "category": "site_permissions",
    "skills": ["settings_navigation", "permission_management", "security_configuration"]
  }
}