{
  "id": "download_auto_open@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome download location to a custom directory (MyDownloads) and optionally enable auto-open for safe file types like PDFs",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/download_auto_open/setup_task.sh",
    "post_task": "/workspace/tasks/download_auto_open/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  },
  "metadata": {
    "difficulty": "medium",
    "category": "configuration",
    "skills": ["settings_navigation", "file_management", "preferences_modification"],
    "estimated_time": "60-90 seconds"
  }
}