{
  "id": "bookmark_export_html@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Export Chrome bookmarks to HTML file for backup using Bookmark Manager's export functionality",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_export_html/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_export_html/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}