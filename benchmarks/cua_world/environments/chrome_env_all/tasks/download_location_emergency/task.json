{
  "id": "download_location_emergency@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Change Chrome's download location from the default Downloads folder to secondary storage at /home/ga/secondary_storage/downloads/ to handle disk space constraints.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/download_location_emergency/setup_task.sh",
    "post_task": "/workspace/tasks/download_location_emergency/export_settings.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  },
  "metadata": {
    "category": "settings_configuration",
    "difficulty": "intermediate",
    "scenario": "emergency_storage_management",
    "skills": ["settings_navigation", "file_system_awareness", "configuration_management"]
  }
}