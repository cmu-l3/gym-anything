{
  "id": "example_url_navigation@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to the United Airlines baggage fee calculator page",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/example_url_navigation/setup_task.sh",
    "post_task": "/workspace/tasks/example_url_navigation/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::check_url_navigation"
    }
  }
}

