{
  "id": "geolocation_sensors_override@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome DevTools Sensors panel to override device geolocation to San Francisco coordinates for testing location-based features",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/geolocation_sensors_override/setup_task.sh",
    "post_task": "/workspace/tasks/geolocation_sensors_override/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}