{
  "id": "install_extension@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Install an ad-blocking extension from the Chrome Web Store to reduce intrusive advertisements and improve browsing experience",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/install_extension/setup_task.sh",
    "post_task": "/workspace/tasks/install_extension/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}