{
  "id": "font_size_config@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Increase Chrome's default font size for better readability by navigating to Settings and adjusting the font size in the Appearance section.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/font_size_config/setup_task.sh",
    "post_task": "/workspace/tasks/font_size_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}