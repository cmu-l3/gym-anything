{
  "id": "tab_discard_exceptions@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome Memory Saver feature and add site-specific exceptions (mail.google.com, calendar.google.com) to prevent important tabs from being discarded when inactive.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_discard_exceptions/setup_memory_saver_task.sh",
    "post_task": "/workspace/tasks/tab_discard_exceptions/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}