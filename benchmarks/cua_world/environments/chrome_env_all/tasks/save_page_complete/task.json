{
  "id": "save_page_complete@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Wikipedia's Web Archiving article and save the complete webpage with all resources (images, CSS, JS) to Downloads folder as 'web_archiving_complete'",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/save_page_complete/setup_task.sh",
    "post_task": "/workspace/tasks/save_page_complete/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}