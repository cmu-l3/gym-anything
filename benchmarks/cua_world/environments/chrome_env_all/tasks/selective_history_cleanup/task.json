{
  "id": "selective_history_cleanup@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to Chrome history, search for shopping-related entries, and selectively delete them while preserving other browsing history (news, educational, social media sites).",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/selective_history_cleanup/setup_task.sh",
    "post_task": "/workspace/tasks/selective_history_cleanup/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}