{
  "id": "responsive_viewport_test@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome DevTools device emulation to test responsive design by activating device toolbar and configuring mobile viewport",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/responsive_viewport_test/setup_task.sh",
    "post_task": "/workspace/tasks/responsive_viewport_test/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}