{
  "id": "research_tabs@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Open multiple research tabs (Python docs, MDN, Stack Overflow) to organize web resources for a research session",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/research_tabs/setup_task.sh",
    "post_task": "/workspace/tasks/research_tabs/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}