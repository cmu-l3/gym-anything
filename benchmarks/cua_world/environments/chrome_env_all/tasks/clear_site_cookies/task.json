{
  "id": "clear_site_cookies@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Delete all cookies for httpbin.org while preserving cookies from other sites using Chrome's site-specific cookie management",
  "init": {
    "timeout_sec": 120,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_site_cookies/setup_cookies_task.sh",
    "post_task": "/workspace/tasks/clear_site_cookies/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}