{
  "id": "bookmark_all_tabs@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Open multiple AI/ML Wikipedia articles in separate tabs, then use 'Bookmark All Tabs' (Ctrl+Shift+D) to save them into a folder named 'AI Research Resources'",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_all_tabs/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_all_tabs/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}