{
  "id": "site_data_clear@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Chrome's site data settings and completely remove all stored data (cookies, cache, permissions, etc.) for example.org domain.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/site_data_clear/setup_task.sh",
    "post_task": "/workspace/tasks/site_data_clear/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}