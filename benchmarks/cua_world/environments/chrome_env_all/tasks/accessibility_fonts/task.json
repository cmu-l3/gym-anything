{
  "id": "accessibility_fonts@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome font sizes for improved accessibility: set default font to 20px, minimum font to 12px, and fixed-width font to 16px",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/accessibility_fonts/setup_task.sh",
    "post_task": "/workspace/tasks/accessibility_fonts/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}