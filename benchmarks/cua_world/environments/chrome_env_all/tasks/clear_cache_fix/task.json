{
  "id": "clear_cache_fix@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Troubleshoot a website loading issue by clearing site-specific cache and cookies for example-site.com without affecting other websites.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/clear_cache_fix/setup_task.sh",
    "post_task": "/workspace/tasks/clear_cache_fix/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}