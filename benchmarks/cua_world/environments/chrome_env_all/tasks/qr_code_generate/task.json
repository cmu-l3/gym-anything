{
  "id": "qr_code_generate@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to Wikipedia homepage and generate a QR code for the page using Chrome's built-in QR code feature. Download the QR code image.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/qr_code_generate/setup_task.sh",
    "post_task": "/workspace/tasks/qr_code_generate/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}