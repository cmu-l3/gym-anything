{
  "id": "network_throttling@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome DevTools Network Throttling to Slow 3G preset for performance testing. Open DevTools, navigate to Network panel, and enable Slow 3G throttling.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/network_throttling/setup_task.sh",
    "post_task": "/workspace/tasks/network_throttling/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}