{
  "id": "devtools_css_override@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome DevTools to inspect and modify CSS styles - change heading background to gold and text to dark blue using Elements panel live editing",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/devtools_css_override/setup_task.sh",
    "post_task": "/workspace/tasks/devtools_css_override/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}