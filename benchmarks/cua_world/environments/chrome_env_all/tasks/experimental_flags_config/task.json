{
  "id": "experimental_flags_config@1",
  "version": "1.0",
  "env_id": "chrome_env_all",
  "description": "Navigate to chrome://flags, search for and enable the 'smooth-scrolling' experimental feature, then relaunch Chrome to apply changes",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/experimental_flags_config/setup_task.sh",
    "post_task": "/workspace/tasks/experimental_flags_config/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}