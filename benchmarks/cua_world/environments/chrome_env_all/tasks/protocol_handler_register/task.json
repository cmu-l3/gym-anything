{
  "id": "protocol_handler_register@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Register a custom protocol handler for mailto: links by navigating to a test page, clicking the registration button, and accepting the permission prompt in Chrome.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/protocol_handler_register/setup_task.sh",
    "post_task": "/workspace/tasks/protocol_handler_register/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}