{
  "id": "notification_permission_cleanup@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Revoke notification permissions from unwanted websites (newsdaily.com, celebritygossip.net, dealsalert.shop) while preserving permissions for work-calendar.company.com",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/notification_permission_cleanup/setup_notification_task.sh",
    "post_task": "/workspace/tasks/notification_permission_cleanup/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}