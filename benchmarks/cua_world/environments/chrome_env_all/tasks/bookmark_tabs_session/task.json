{
  "id": "bookmark_tabs_session@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Open multiple Wikipedia AI-related pages in tabs, then use 'Bookmark all tabs' to save them as a folder named 'AI Research Session'",
  "init": {
    "timeout_sec": 180,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_tabs_session/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_tabs_session/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}