{
  "id": "network_request_blocking@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome DevTools Network Request Blocking to block analytics scripts, JPEG images, and a specific CDN domain by adding blocking patterns",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/network_request_blocking/setup_task.sh",
    "post_task": "/workspace/tasks/network_request_blocking/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}