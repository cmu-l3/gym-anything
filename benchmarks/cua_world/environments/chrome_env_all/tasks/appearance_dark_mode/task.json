{
  "id": "appearance_dark_mode@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome's appearance settings to enable dark mode and customize the browser UI for better visual comfort",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/appearance_dark_mode/setup_task.sh",
    "post_task": "/workspace/tasks/appearance_dark_mode/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}