{
  "id": "tab_audio_mute@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Manage audio playback across multiple browser tabs by selectively muting tabs with audio content while preserving silent tabs",
  "init": {
    "timeout_sec": 180,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_audio_mute/setup_task.sh",
    "post_task": "/workspace/tasks/tab_audio_mute/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}