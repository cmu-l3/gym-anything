{
  "id": "media_autoplay_control@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Configure Chrome to block automatic media playback on a specific website (example-news-site.com) using site-specific content settings.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/media_autoplay_control/setup_task.sh",
    "post_task": "/workspace/tasks/media_autoplay_control/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}