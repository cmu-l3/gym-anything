{
  "id": "save_mhtml@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Save a complete webpage as a single MHTML file for offline reading and archiving",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/save_mhtml/setup_task.sh",
    "post_task": "/workspace/tasks/save_mhtml/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}