{
  "id": "download_history_search@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome's download management interface to locate previously downloaded files by navigating to chrome://downloads/ and searching for specific file patterns",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/download_history_search/setup_download_task.sh",
    "post_task": "/workspace/tasks/download_history_search/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}