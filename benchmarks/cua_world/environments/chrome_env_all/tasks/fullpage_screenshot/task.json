{
  "id": "fullpage_screenshot@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome DevTools to capture a full-page screenshot of a long webpage. Open DevTools (F12), access Command Menu (Ctrl+Shift+P), and select 'Capture full size screenshot'.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 10,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/fullpage_screenshot/setup_task.sh",
    "post_task": "/workspace/tasks/fullpage_screenshot/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}