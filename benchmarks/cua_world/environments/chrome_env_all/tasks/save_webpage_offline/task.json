{
  "id": "save_webpage_offline@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Save a complete webpage with all resources for offline reading. Use 'Save as Webpage, Complete' format to ensure all images and styling are preserved.",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/save_webpage_offline/setup_task.sh",
    "post_task": "/workspace/tasks/save_webpage_offline/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}