{
  "id": "selective_privacy_clear@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Clear sensitive browsing data (history, cookies, cache) while preserving bookmarks and passwords before lending device to a friend",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/selective_privacy_clear/setup_task.sh",
    "post_task": "/workspace/tasks/selective_privacy_clear/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}