{
  "id": "tab_pin_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Open 5 tabs with specific URLs, pin MDN and Stack Overflow tabs, unpin GitHub tab, and organize workspace for efficient browsing",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_pin_organize/setup_task.sh",
    "post_task": "/workspace/tasks/tab_pin_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}