{
  "id": "extension_disable_enable@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Navigate to chrome://extensions/ and disable the 'Test Productivity Extension' to manage browser extensions and improve performance",
  "init": {
    "timeout_sec": 90,
    "max_steps": 8,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extension_disable_enable/setup_task.sh",
    "post_task": "/workspace/tasks/extension_disable_enable/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}