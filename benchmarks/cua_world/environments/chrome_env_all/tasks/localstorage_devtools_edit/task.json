{
  "id": "localstorage_devtools_edit@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Use Chrome DevTools Application panel to inspect and manipulate localStorage by adding key-value pairs: userPreference=darkMode and sessionToken=abc123xyz789",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/localstorage_devtools_edit/setup_task.sh",
    "post_task": "/workspace/tasks/localstorage_devtools_edit/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}