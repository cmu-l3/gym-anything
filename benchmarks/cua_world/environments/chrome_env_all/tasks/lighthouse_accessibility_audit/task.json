{
  "id": "lighthouse_accessibility_audit@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome DevTools Lighthouse to perform an accessibility audit on a webpage and export the results to verify accessibility standards compliance",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/lighthouse_accessibility_audit/setup_task.sh",
    "post_task": "/workspace/tasks/lighthouse_accessibility_audit/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}