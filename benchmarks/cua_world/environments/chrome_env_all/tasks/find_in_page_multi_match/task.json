{
  "id": "find_in_page_multi_match@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Use Chrome's Find in Page feature (Ctrl+F) to search for 'example' in a test document and navigate to the 3rd occurrence of the search term",
  "init": {
    "timeout_sec": 90,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/find_in_page_multi_match/setup_task.sh",
    "post_task": "/workspace/tasks/find_in_page_multi_match/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}