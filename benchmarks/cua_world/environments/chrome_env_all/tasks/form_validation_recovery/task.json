{
  "id": "form_validation_recovery@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Interact with a web form that has client-side validation, intentionally trigger validation errors, interpret error messages, correct the errors, and successfully submit the form.",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/form_validation_recovery/setup_task.sh",
    "post_task": "/workspace/tasks/form_validation_recovery/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}