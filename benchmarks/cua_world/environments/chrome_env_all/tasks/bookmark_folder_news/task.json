{
  "id": "bookmark_folder_news@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Create a 'News' folder in Chrome's bookmark bar and add three news website bookmarks: Hacker News, BBC News, and Reuters.",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_folder_news/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_folder_news/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}