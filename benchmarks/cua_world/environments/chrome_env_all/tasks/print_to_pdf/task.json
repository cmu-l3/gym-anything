{
  "id": "print_to_pdf@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Print a webpage to PDF with landscape orientation and minimal margins. Save as 'machine_learning_fundamentals.pdf'.",
  "init": {
    "timeout_sec": 180,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/print_to_pdf/setup_task.sh",
    "post_task": "/workspace/tasks/print_to_pdf/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}