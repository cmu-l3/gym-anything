{
  "id": "video_playback_speed@1",
  "version": "1.0",
  "env_id": "example.chrome_env_all@0.1",
  "description": "Navigate to a video webpage and adjust the playback speed to 1.5x using the video player controls",
  "init": {
    "timeout_sec": 120,
    "max_steps": 12,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/video_playback_speed/setup_task.sh",
    "post_task": "/workspace/tasks/video_playback_speed/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}