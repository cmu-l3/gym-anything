{
  "id": "device_mode_capture@1",
  "version": "1.0",
  "env_id": "chrome_env_all@0.1",
  "description": "Use Chrome DevTools Device Mode to emulate iPhone SE viewport (375x667) and capture screenshot of example.com",
  "init": {
    "timeout_sec": 120,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/device_mode_capture/setup_task.sh",
    "post_task": "/workspace/tasks/device_mode_capture/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}