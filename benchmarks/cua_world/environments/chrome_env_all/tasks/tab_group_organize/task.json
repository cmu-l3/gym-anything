{
  "id": "tab_group_organize@1",
  "version": "1.0",
  "env_id": "example.chrome_env@0.1",
  "description": "Organize 15+ open tabs into logical tab groups with names and colors. Create at least 3 groups (e.g., 'Research', 'Shopping', 'News') and assign tabs appropriately.",
  "init": {
    "timeout_sec": 180,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tab_group_organize/setup_task.sh",
    "post_task": "/workspace/tasks/tab_group_organize/export_result.sh"
  },
  "success": {
    "spec": {
      "program": "verifier.py::verify_task"
    }
  }
}