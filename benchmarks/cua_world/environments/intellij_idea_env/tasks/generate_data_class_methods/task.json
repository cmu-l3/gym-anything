{
  "id": "generate_data_class_methods@1",
  "version": "1.0",
  "env_id": "intellij_idea_env@0.1",
  "description": "Open the 'data-models' project in IntelliJ IDEA. For each of the three Java classes (Person, Address, Order), generate the following boilerplate code using IntelliJ's 'Generate' features (Alt+Insert):\n\n1. A Constructor using ALL fields\n2. Getters and Setters for ALL fields\n3. equals() and hashCode() methods using ALL fields\n4. toString() method using ALL fields\n\nEnsure the project compiles successfully after generating the code.",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 420,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/generate_data_class_methods/setup_task.sh",
    "post_task": "/workspace/tasks/generate_data_class_methods/export_result.sh"
  },
  "metadata": {
    "project_path": "/home/ga/IdeaProjects/data-models",
    "classes": [
      {
        "name": "Person",
        "path": "src/main/java/com/example/models/Person.java",
        "fields": ["firstName", "lastName", "age", "email"]
      },
      {
        "name": "Address",
        "path": "src/main/java/com/example/models/Address.java",
        "fields": ["street", "city", "state", "zipCode", "country"]
      },
      {
        "name": "Order",
        "path": "src/main/java/com/example/models/Order.java",
        "fields": ["orderId", "customerName", "items", "totalAmount", "orderDate"]
      }
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_generate_data_class_methods"
    }
  }
}