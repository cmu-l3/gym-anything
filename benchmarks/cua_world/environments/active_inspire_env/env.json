{
  "id": "active_inspire_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "description": "ActivInspire interactive whiteboard software environment for creating educational presentations, annotations, and interactive flipcharts. ActivInspire is Promethean's flagship educational software used in classrooms worldwide for creating engaging lesson materials. NOTE: Currently BLOCKED on Ubuntu 22.04 due to OpenSSL version incompatibility. Requires Ubuntu 20.04 base image for full functionality.",
  "status": "blocked",
  "status_reason": "OpenSSL version incompatibility - ActivInspire requires OpenSSL 1.x, Ubuntu 22.04 has OpenSSL 3.x",
  "required_base": "ubuntu-focal-gnome-systemd (Ubuntu 20.04)",
  "category": "education",
  "tags": ["linux", "education", "whiteboard", "presentation", "desktop", "blocked"],
  "licence": "Proprietary (Promethean)",
  "authors": ["gym-anything team"],
  "upstream_url": "https://www.prometheanworld.com/products/software/activinspire/",
  "diagnostics": true,
  "resources": {
    "cpu": 4,
    "mem_gb": 4,
    "gpu": 0,
    "net": true
  },
  "observation": [
    {
      "type": "rgb_screen",
      "fps": 10,
      "resolution": [1920, 1080],
      "inline": false
    }
  ],
  "action": [
    {"type": "mouse"},
    {"type": "keyboard"}
  ],
  "synchronous": true,
  "step_cycle_ms": 250,
  "recording": {
    "enable": true,
    "output_dir": "artifacts",
    "video_fps": 10,
    "video_resolution": [1920, 1080],
    "video_codec": "libx264",
    "video_crf": 23
  },
  "vnc": {
    "enable": true,
    "host_port": 5960,
    "view_only": false,
    "password": "password"
  },
  "mounts": [
    {
      "source": "benchmarks/cua_world/environments/active_inspire_env/scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "benchmarks/cua_world/environments/active_inspire_env/config",
      "target": "/workspace/config",
      "mode": "ro"
    },
    {
      "source": "benchmarks/cua_world/environments/active_inspire_env/tasks",
      "target": "/workspace/tasks",
      "mode": "ro"
    },
    {
      "source": "benchmarks/cua_world/environments/active_inspire_env/assets",
      "target": "/workspace/assets",
      "mode": "rw"
    }
  ],
  "hooks": {
    "pre_start": "/workspace/scripts/install_activinspire.sh",
    "post_start": "/workspace/scripts/setup_activinspire.sh"
  },
  "user_accounts": [
    {
      "name": "ga",
      "password": "password123",
      "role": "teacher",
      "permissions": {
        "sudo": true,
        "sudo_nopasswd": true,
        "groups": ["sudo", "audio", "video", "input"],
        "shell": "/bin/bash",
        "env_vars": {
          "DISPLAY": ":1"
        }
      }
    }
  ]
}
