{
  "id": "export_oldest_items_csv@1",
  "version": "1.0",
  "env_id": "juris_m_env@0.1",
  "description": "Sort your Jurism library by Date (oldest to newest) to find the historical precedents. Select the three oldest items (from 1803, 1897, and 1954) and export them to a CSV file. Name the file 'oldest_precedents.csv' and save it in the '/home/ga/Documents/' directory.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/export_oldest_items_csv/setup_task.sh",
    "post_task": "/workspace/tasks/export_oldest_items_csv/export_result.sh"
  },
  "metadata": {
    "expected_filename": "oldest_precedents.csv",
    "expected_path": "/home/ga/Documents/oldest_precedents.csv",
    "required_items": [
      "Marbury",
      "Path of the Law",
      "Brown"
    ],
    "forbidden_items": [
      "Obergefell",
      "Tinker",
      "Miranda"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_export_oldest_items_csv"
    }
  }
