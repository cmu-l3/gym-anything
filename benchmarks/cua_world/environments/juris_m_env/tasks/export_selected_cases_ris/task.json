{
  "id": "export_selected_cases_ris@1",
  "version": "1.0",
  "env_id": "juris_m_env@0.1",
  "description": "Select exactly three specific US Supreme Court cases from your Juris-M library: 'Brown v. Board of Education', 'Miranda v. Arizona', and 'Gideon v. Wainwright'. Export these three selected items (and only these three) to a RIS file named 'landmark_cases.ris' in the Documents folder (/home/ga/Documents/landmark_cases.ris). Do not export the entire collection.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/export_selected_cases_ris/setup_task.sh",
    "post_task": "/workspace/tasks/export_selected_cases_ris/export_result.sh"
  },
  "metadata": {
    "expected_output_path": "/home/ga/Documents/landmark_cases.ris",
    "required_cases": [
      "Brown v. Board of Education",
      "Miranda v. Arizona",
      "Gideon v. Wainwright"
    ],
    "unwanted_cases": [
      "Marbury v. Madison",
      "Obergefell v. Hodges",
      "Tinker v. Des Moines"
    ],
    "expected_item_count": 3
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_export_selected_cases_ris"
    }
  }
}