{
  "id": "update_service_price@1",
  "version": "1.0",
  "env_id": "hospitalrun_env@0.1",
  "description": "Update the existing pricing item 'General Consultation' to reflect a new hospital policy. Navigate to Administration > Pricing, locate the item 'General Consultation', and change its Name to 'Standard GP Consultation' and its Price to '60.00'. Save the changes.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/update_service_price/setup_task.sh",
    "post_task": "/workspace/tasks/update_service_price/export_result.sh"
  },
  "metadata": {
    "target_doc_id": "pricing_task_target_001",
    "initial_name": "General Consultation",
    "initial_price": 50.00,
    "expected_name": "Standard GP Consultation",
    "expected_price": 60.00
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_update_service_price"
    }
  }
}