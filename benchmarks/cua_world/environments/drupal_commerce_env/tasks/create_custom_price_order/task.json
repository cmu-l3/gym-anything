{
  "id": "create_custom_price_order@1",
  "version": "1.0",
  "env_id": "drupal_commerce_env@0.1",
  "name": "Create Custom Price Order",
  "description": "Create a new order for customer 'mikewilson'. Add 'Samsung Galaxy Buds2 Pro' and 'Logitech MX Master 3S' to the cart. Manually override the price of the Samsung earbuds to $120.00 (due to damaged packaging) while keeping the Logitech mouse at regular price. Finally, place the order.",
  "difficulty": "hard",
  "init": {
    "timeout_sec": 600,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "chmod +x /workspace/tasks/create_custom_price_order/setup_task.sh && bash -l /workspace/tasks/create_custom_price_order/setup_task.sh",
    "post_task": "chmod +x /workspace/tasks/create_custom_price_order/export_result.sh && bash -l /workspace/tasks/create_custom_price_order/export_result.sh"
  },
  "metadata": {
    "customer_username": "mikewilson",
    "discounted_sku": "SAMSUNG-BUDS2",
    "discounted_product_title": "Samsung Galaxy Buds2 Pro",
    "regular_sku": "LOGI-MXM3S",
    "regular_product_title": "Logitech MX Master 3S",
    "discounted_price": "120.00",
    "regular_price": "99.99"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_custom_price_order"
    }
  }
}
