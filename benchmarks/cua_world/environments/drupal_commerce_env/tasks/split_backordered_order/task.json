{
  "id": "split_backordered_order@1",
  "version": "1.0",
  "env_id": "drupal_commerce_env@0.1",
  "name": "Manually Split Backordered Order",
  "description": "Split a customer's mixed-availability draft order into two separate orders: one to be placed immediately with in-stock items, and one to remain in draft for the backordered item.",
  "difficulty": "hard",
  "tags": ["commerce", "order-management", "workflow", "customer-service"],
  "init": {
    "timeout_sec": 600,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "chmod +x /workspace/tasks/split_backordered_order/setup_task.sh && bash -l /workspace/tasks/split_backordered_order/setup_task.sh",
    "post_task": "chmod +x /workspace/tasks/split_backordered_order/export_result.sh && bash -l /workspace/tasks/split_backordered_order/export_result.sh"
  },
  "metadata": {
    "customer_username": "janesmith",
    "original_order_id_file": "/tmp/original_order_id.txt",
    "in_stock_skus": ["SONY-WH1000XM5", "LOGI-MXM3S"],
    "backordered_sku": "DELL-XPS13-16-512"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_split_backordered_order"
    }
  }
}
