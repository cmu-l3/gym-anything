{
  "id": "extract_audio_podcast@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract audio from a conference video and save as MP3 for portable listening",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_audio_podcast/setup_task.sh",
    "post_task": "/workspace/tasks/extract_audio_podcast/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_audio_podcast"
    }
  }
}