{
  "id": "batch_audio_balance@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Balance volume levels across multiple podcast audio segments to achieve consistent loudness",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 45,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/batch_audio_balance/setup_task.sh",
    "post_task": "/workspace/tasks/batch_audio_balance/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_batch_audio_balance"
    }
  }
}