{
  "id": "setup_exhibition_loop@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC for unattended exhibition display with continuous looping and minimal interface",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/setup_exhibition_loop/setup_task.sh",
    "post_task": "/workspace/tasks/setup_exhibition_loop/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_setup_exhibition_loop"
    }
  }
}