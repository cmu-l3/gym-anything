{
  "id": "stream_network_media@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Stream media from a network URL and save to playlist",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/stream_network_media/setup_task.sh",
    "post_task": "/workspace/tasks/stream_network_media/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_stream_network_media"
    }
  }
}