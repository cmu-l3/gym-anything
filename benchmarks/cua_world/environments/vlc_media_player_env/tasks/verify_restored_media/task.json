{
  "id": "verify_restored_media@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Systematically verify media files from a restored backup directory to ensure data integrity",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_restored_media/setup_task.sh",
    "post_task": "/workspace/tasks/verify_restored_media/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_restored_media"
    }
  }
}