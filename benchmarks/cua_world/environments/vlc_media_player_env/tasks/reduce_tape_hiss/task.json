{
  "id": "reduce_tape_hiss@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Apply noise reduction filter to remove tape hiss from digitized analog recording",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/reduce_tape_hiss/setup_task.sh",
    "post_task": "/workspace/tasks/reduce_tape_hiss/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_noise_reduction"
    }
  }
}