{
  "id": "watermark_video_proof@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Add a text watermark overlay to a video file using VLC's conversion feature with text overlay filters",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/watermark_video_proof/setup_task.sh",
    "post_task": "/workspace/tasks/watermark_video_proof/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_watermark_video"
    }
  }
}