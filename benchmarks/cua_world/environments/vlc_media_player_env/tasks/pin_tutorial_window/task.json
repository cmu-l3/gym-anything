{
  "id": "pin_tutorial_window@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC as an always-visible tutorial window by enabling always-on-top mode and positioning in top-right corner",
  "difficulty": "easy-medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/pin_tutorial_window/setup_task.sh",
    "post_task": "/workspace/tasks/pin_tutorial_window/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_pin_tutorial_window"
    }
  }
}