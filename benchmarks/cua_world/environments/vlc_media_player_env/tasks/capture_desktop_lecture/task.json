{
  "id": "capture_desktop_lecture@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Capture desktop screen recording using VLC's capture device feature",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/capture_desktop_lecture/setup_task.sh",
    "post_task": "/workspace/tasks/capture_desktop_lecture/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_capture_desktop"
    }
  }
}