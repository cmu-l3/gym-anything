{
  "id": "extract_lecture_highlights@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract 4 audio segments from a lecture video at specific timestamps for study review",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_lecture_highlights/setup_task.sh",
    "post_task": "/workspace/tasks/extract_lecture_highlights/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_lecture_highlights"
    }
  }
}