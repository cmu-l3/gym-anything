{
  "id": "study_dialogue_delivery@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Set up VLC for voice acting reference study with A-B loop, time display, and snapshot workflow",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 45,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/study_dialogue_delivery/setup_task.sh",
    "post_task": "/workspace/tasks/study_dialogue_delivery/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_study_dialogue_delivery"
    }
  }
}