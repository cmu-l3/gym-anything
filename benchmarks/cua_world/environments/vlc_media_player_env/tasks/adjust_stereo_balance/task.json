{
  "id": "adjust_stereo_balance@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to shift stereo audio balance toward right channel for accessibility (hearing loss or damaged audio hardware)",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/adjust_stereo_balance/setup_task.sh",
    "post_task": "/workspace/tasks/adjust_stereo_balance/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_adjust_stereo_balance"
    }
  }
}