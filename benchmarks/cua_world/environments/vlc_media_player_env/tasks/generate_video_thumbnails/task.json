{
  "id": "generate_video_thumbnails@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract exactly 12 thumbnail images evenly distributed throughout a video using VLC's scene filter",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/generate_video_thumbnails/setup_task.sh",
    "post_task": "/workspace/tasks/generate_video_thumbnails/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_generate_video_thumbnails"
    }
  }
}