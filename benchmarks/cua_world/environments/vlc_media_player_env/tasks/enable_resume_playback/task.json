{
  "id": "enable_resume_playback@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to automatically save and resume playback positions",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/enable_resume_playback/setup_task.sh",
    "post_task": "/workspace/tasks/enable_resume_playback/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_enable_resume_playback"
    }
  }
}