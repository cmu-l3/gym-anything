{
  "id": "adjust_volume@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Adjust VLC volume to a target level (75%) using GUI or keyboard shortcuts",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 45,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/adjust_volume/setup_task.sh",
    "post_task": "/workspace/tasks/adjust_volume/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_adjust_volume"
    }
  }
}
