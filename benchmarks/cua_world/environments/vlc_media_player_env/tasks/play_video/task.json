{
  "id": "play_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Play a video file to completion and verify successful playback",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 60,
    "max_steps": 15,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/play_video/setup_task.sh",
    "post_task": "/workspace/tasks/play_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_play_video"
    }
  }
}
