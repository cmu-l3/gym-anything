{
  "id": "tag_media_metadata@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Add comprehensive metadata tags to a concert recording video file using VLC's Media Information editor",
  "difficulty": "medium",
  "tags": ["metadata", "organization", "library-management", "tagging", "media-info"],
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/tag_media_metadata/setup_task.sh",
    "post_task": "/workspace/tasks/tag_media_metadata/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_tag_metadata"
    }
  }
}