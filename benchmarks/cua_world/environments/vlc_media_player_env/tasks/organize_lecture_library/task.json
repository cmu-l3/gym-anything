{
  "id": "organize_lecture_library@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Organize scattered lecture recordings into course-specific folders with proper naming and playlists",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/organize_lecture_library/setup_task.sh",
    "post_task": "/workspace/tasks/organize_lecture_library/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_organize_lecture_library"
    }
  }
}