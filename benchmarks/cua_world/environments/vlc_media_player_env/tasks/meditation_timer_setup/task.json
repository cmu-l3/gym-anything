{
  "id": "meditation_timer_setup@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to automatically quit after 30 minutes for meditation sessions",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/meditation_timer_setup/setup_task.sh",
    "post_task": "/workspace/tasks/meditation_timer_setup/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_meditation_timer_setup"
    }
  }
}