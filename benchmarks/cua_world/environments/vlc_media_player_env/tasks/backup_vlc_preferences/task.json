{
  "id": "backup_vlc_preferences@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Backup VLC preferences and configuration files to preserve settings for migration",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/backup_vlc_preferences/setup_task.sh",
    "post_task": "/workspace/tasks/backup_vlc_preferences/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_backup_vlc_preferences"
    }
  }
}