{
  "id": "verify_audio_spectrum@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Enable VLC's spectrum analyzer to visually verify audio quality claims and detect fake lossless files",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_audio_spectrum/setup_task.sh",
    "post_task": "/workspace/tasks/verify_audio_spectrum/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_audio_spectrum"
    }
  }
}