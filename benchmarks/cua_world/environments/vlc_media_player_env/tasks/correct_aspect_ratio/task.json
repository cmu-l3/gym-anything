{
  "id": "correct_aspect_ratio@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to force correct 4:3 aspect ratio for a video with incorrect 16:9 metadata",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/correct_aspect_ratio/setup_task.sh",
    "post_task": "/workspace/tasks/correct_aspect_ratio/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_correct_aspect_ratio"
    }
  }
}