{
  "id": "verify_surround_channels@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to output to multi-channel audio device and disable stereo downmixing",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/verify_surround_channels/setup_task.sh",
    "post_task": "/workspace/tasks/verify_surround_channels/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_surround_channels"
    }
  }
}