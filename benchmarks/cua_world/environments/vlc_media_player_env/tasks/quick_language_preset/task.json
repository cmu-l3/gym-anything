{
  "id": "quick_language_preset@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Create quick-switch language presets for multi-audio/subtitle video",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/quick_language_preset/setup_task.sh",
    "post_task": "/workspace/tasks/quick_language_preset/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_quick_language_preset"
    }
  }
}