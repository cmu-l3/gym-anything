{
  "id": "identify_bird_call@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract a bird call segment from a long audio recording for species identification",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/identify_bird_call/setup_task.sh",
    "post_task": "/workspace/tasks/identify_bird_call/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_identify_bird_call"
    }
  }
}