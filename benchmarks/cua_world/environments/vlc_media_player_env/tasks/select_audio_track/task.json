{
  "id": "select_audio_track@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Select a specific audio track (English dub) from a multi-audio-track video file",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/select_audio_track/setup_task.sh",
    "post_task": "/workspace/tasks/select_audio_track/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_select_audio_track"
    }
  }
}