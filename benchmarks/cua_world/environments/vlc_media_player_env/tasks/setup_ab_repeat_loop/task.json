{
  "id": "setup_ab_repeat_loop@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC's A-B repeat loop to continuously play a specific 15-second segment of an interview recording, enabling efficient transcription work",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/setup_ab_repeat_loop/setup_task.sh",
    "post_task": "/workspace/tasks/setup_ab_repeat_loop/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_ab_repeat_loop"
    }
  }
}