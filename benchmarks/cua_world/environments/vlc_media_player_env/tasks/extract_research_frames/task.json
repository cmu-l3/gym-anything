{
  "id": "extract_research_frames@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract multiple specific frames from a video at precise timestamps for research documentation",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_research_frames/setup_task.sh",
    "post_task": "/workspace/tasks/extract_research_frames/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_research_frames"
    }
  }
}