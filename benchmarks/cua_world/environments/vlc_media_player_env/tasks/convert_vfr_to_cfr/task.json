{
  "id": "convert_vfr_to_cfr@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Convert variable frame rate (VFR) screen recording to constant 30fps (CFR) for editing compatibility",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/convert_vfr_to_cfr/setup_task.sh",
    "post_task": "/workspace/tasks/convert_vfr_to_cfr/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_convert_vfr_to_cfr"
    }
  }
}