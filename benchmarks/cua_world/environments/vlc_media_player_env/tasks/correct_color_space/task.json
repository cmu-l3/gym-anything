{
  "id": "correct_color_space@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Correct washed-out and greenish video colors by adjusting VLC's color space and gamma settings",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/correct_color_space/setup_task.sh",
    "post_task": "/workspace/tasks/correct_color_space/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_correct_color_space"
    }
  }
}