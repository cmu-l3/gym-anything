{
  "id": "compare_voice_takes@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Review multiple voice recording takes and select the best one based on audio quality and performance",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/compare_voice_takes/setup_task.sh",
    "post_task": "/workspace/tasks/compare_voice_takes/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_compare_voice_takes"
    }
  }
}