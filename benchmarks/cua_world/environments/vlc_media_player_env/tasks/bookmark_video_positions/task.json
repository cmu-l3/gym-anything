{
  "id": "bookmark_video_positions@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Create bookmarks at specific timestamps in a long video for easy navigation between viewing sessions",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/bookmark_video_positions/setup_task.sh",
    "post_task": "/workspace/tasks/bookmark_video_positions/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_task"
    }
  },
  "tags": ["vlc", "bookmarks", "navigation", "media-library", "playlist", "medium"]
}