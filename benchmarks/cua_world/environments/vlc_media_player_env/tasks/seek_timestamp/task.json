{
  "id": "seek_timestamp@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Seek to a specific timestamp (15 seconds) in a playing video",
  "difficulty": "easy",
  "init": {
    "timeout_sec": 40,
    "max_steps": 20,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/seek_timestamp/setup_task.sh",
    "post_task": "/workspace/tasks/seek_timestamp/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_seek_timestamp"
    }
  }
}
