{
  "id": "isolate_dialogue_track@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC audio filters to isolate center channel dialogue from background music",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/isolate_dialogue_track/setup_task.sh",
    "post_task": "/workspace/tasks/isolate_dialogue_track/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_isolate_dialogue"
    }
  }
}