{
  "id": "configure_shuffle_no_repeat@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to shuffle play videos with repeat-all mode (no repeat-one)",
  "difficulty": "easy-medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_shuffle_no_repeat/setup_task.sh",
    "post_task": "/workspace/tasks/configure_shuffle_no_repeat/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_shuffle_no_repeat"
    }
  }
}