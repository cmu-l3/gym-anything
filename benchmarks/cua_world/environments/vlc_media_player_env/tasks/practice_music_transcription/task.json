{
  "id": "practice_music_transcription@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC time-stretching playback at 60% speed for music transcription practice",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/practice_music_transcription/setup_task.sh",
    "post_task": "/workspace/tasks/practice_music_transcription/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_practice_music_transcription"
    }
  }
}