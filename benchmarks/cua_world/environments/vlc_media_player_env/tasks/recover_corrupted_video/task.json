{
  "id": "recover_corrupted_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to handle and play through a partially corrupted video file using advanced error recovery settings",
  "difficulty": "medium+",
  "init": {
    "timeout_sec": 180,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/recover_corrupted_video/setup_task.sh",
    "post_task": "/workspace/tasks/recover_corrupted_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_recover_corrupted_video"
    }
  }
}