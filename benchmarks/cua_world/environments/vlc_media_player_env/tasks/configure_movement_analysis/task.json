{
  "id": "configure_movement_analysis@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC for movement analysis: slow playback, A-B loop, and time display",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 45,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_movement_analysis/setup_task.sh",
    "post_task": "/workspace/tasks/configure_movement_analysis/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_movement_analysis"
    }
  }
}