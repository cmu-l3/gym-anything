{
  "id": "extract_audio_from_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract audio track from video and save as MP3 with 192 kbps bitrate",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_audio_from_video/setup_task.sh",
    "post_task": "/workspace/tasks/extract_audio_from_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_audio"
    }
  }
}