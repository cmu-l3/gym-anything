{
  "id": "compress_for_email@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Compress a large video file to under 25MB for email sharing while maintaining acceptable quality",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/compress_for_email/setup_task.sh",
    "post_task": "/workspace/tasks/compress_for_email/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_compress_for_email"
    }
  }
}