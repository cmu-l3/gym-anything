{
  "id": "mirror_dance_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Transform a dance video by rotating 90° and horizontally flipping it, then save the result",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "continuous"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/mirror_dance_video/setup_task.sh",
    "post_task": "/workspace/tasks/mirror_dance_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_mirror_dance_video"
    }
  },
  "metadata": {
    "tags": ["video", "transformation", "rotation", "flip", "mirror", "conversion", "geometry"],
    "skills": ["video_effects", "geometry_transformations", "video_conversion", "multi_step_workflow"],
    "real_world_use_case": "dance_instruction_video_preparation"
  }
}