{
  "id": "extract_video_segment@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Extract a specific 30-second segment from a 10-minute video using VLC recording",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/extract_video_segment/setup_task.sh",
    "post_task": "/workspace/tasks/extract_video_segment/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_extract_video_segment"
    }
  }
}