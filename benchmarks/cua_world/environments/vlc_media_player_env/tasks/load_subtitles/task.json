{
  "id": "load_subtitles@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Load a subtitle file and verify it's synchronized with the video",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/load_subtitles/setup_task.sh",
    "post_task": "/workspace/tasks/load_subtitles/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_load_subtitles"
    }
  }
}
