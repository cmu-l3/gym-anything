{
  "id": "zoom_video_region@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to zoom video by 200% to read small text in tutorial",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/zoom_video_region/setup_task.sh",
    "post_task": "/workspace/tasks/zoom_video_region/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_zoom_video_region"
    }
  }
}