{
  "id": "record_synchronized_commentary@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Record synchronized audio commentary while playing back video footage",
  "difficulty": "medium",
  "category": "audio_recording",
  "metadata": {
    "tags": ["audio", "recording", "commentary", "synchronization", "voiceover"],
    "estimated_time_sec": 180,
    "requires_audio_input": true,
    "real_world_use_cases": [
      "Sports coaches annotating game footage",
      "Teachers creating narrated tutorials",
      "Film students recording director commentary",
      "Researchers documenting video analysis"
    ]
  },
  "init": {
    "timeout_sec": 300,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/record_synchronized_commentary/setup_task.sh",
    "post_task": "/workspace/tasks/record_synchronized_commentary/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_commentary_recording"
    }
  }
}