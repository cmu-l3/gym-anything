{
  "id": "optimize_battery_playback@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC for battery-efficient playback by enabling hardware acceleration and disabling CPU-intensive features",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 480,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/optimize_battery_playback/setup_task.sh",
    "post_task": "/workspace/tasks/optimize_battery_playback/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_optimize_battery_playback"
    }
  }
}