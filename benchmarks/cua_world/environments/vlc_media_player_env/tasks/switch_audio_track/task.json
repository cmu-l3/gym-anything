{
  "id": "switch_audio_track@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Switch from default English audio to Japanese audio track in a multilingual video",
  "difficulty": "medium",
  "tags": ["audio", "multi-language", "menu-navigation", "accessibility"],
  "init": {
    "timeout_sec": 90,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/switch_audio_track/setup_task.sh",
    "post_task": "/workspace/tasks/switch_audio_track/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_switch_audio_track"
    }
  }
}