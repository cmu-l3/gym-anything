{
  "id": "create_timelapse@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Create a time-lapse video by speeding up a long recording 60x using VLC's conversion feature",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/create_timelapse/setup_task.sh",
    "post_task": "/workspace/tasks/create_timelapse/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_create_timelapse"
    }
  }
}