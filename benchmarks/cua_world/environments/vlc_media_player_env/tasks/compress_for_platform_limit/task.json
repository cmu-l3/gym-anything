{
  "id": "compress_for_platform_limit@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Compress a video file to under 10MB for platform sharing limits while maintaining acceptable quality",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/compress_for_platform_limit/setup_task.sh",
    "post_task": "/workspace/tasks/compress_for_platform_limit/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_compress_for_platform_limit"
    }
  }
}