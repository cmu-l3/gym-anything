{
  "id": "apply_audio_fadeout@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Apply audio fade-out effect to a video file over the last 15 seconds",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/apply_audio_fadeout/setup_task.sh",
    "post_task": "/workspace/tasks/apply_audio_fadeout/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_audio_fadeout"
    }
  }
}