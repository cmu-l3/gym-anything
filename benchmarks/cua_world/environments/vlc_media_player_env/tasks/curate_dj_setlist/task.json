{
  "id": "curate_dj_setlist@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Assess audio quality of wedding music requests and create a playlist containing only high-quality tracks suitable for professional DJ use (bitrate >= 192 kbps)",
  "difficulty": "medium",
  "tags": ["audio", "quality-assurance", "playlist", "professional", "metadata"],
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/curate_dj_setlist/setup_task.sh",
    "post_task": "/workspace/tasks/curate_dj_setlist/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_curate_dj_setlist"
    }
  }
}