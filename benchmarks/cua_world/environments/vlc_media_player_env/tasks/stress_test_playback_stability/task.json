{
  "id": "stress_test_playback_stability@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Stress test video playback at high speed to verify stability before important presentations",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/stress_test_playback_stability/setup_task.sh",
    "post_task": "/workspace/tasks/stress_test_playback_stability/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_stress_test_playback_stability"
    }
  }
}