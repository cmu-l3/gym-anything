{
  "id": "navigate_dvd_bonus_features@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Navigate DVD ISO menus to access bonus features (Title 2)",
  "difficulty": "medium",
  "tags": ["dvd", "navigation", "menu", "iso", "bonus-content"],
  "init": {
    "timeout_sec": 180,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/navigate_dvd_bonus_features/setup_task.sh",
    "post_task": "/workspace/tasks/navigate_dvd_bonus_features/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_dvd_bonus_navigation"
    }
  }
}