{
  "id": "enable_audio_visualizer@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Enable VLC's audio visualization feature and capture screenshot showing frequency spectrum or waveform",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/enable_audio_visualizer/setup_task.sh",
    "post_task": "/workspace/tasks/enable_audio_visualizer/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_audio_visualizer"
    }
  }
}