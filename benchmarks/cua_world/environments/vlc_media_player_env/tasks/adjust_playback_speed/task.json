{
  "id": "adjust_playback_speed@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Adjust VLC playback speed to 1.5x for time-efficient media consumption",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 90,
    "max_steps": 30,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/adjust_playback_speed/setup_task.sh",
    "post_task": "/workspace/tasks/adjust_playback_speed/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_adjust_playback_speed"
    }
  }
}