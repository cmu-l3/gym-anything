{
  "id": "assess_digitization_quality@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Systematically assess digitized home video for common quality issues and create diagnostic report",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 180,
    "max_steps": 60,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/assess_digitization_quality/setup_task.sh",
    "post_task": "/workspace/tasks/assess_digitization_quality/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_assess_digitization_quality"
    }
  }
}