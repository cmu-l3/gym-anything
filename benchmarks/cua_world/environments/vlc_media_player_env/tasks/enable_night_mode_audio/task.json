{
  "id": "enable_night_mode_audio@1",
  "version": "1.0.0",
  "env_id": "vlc_env@0.1",
  "description": "Enable VLC's audio compression and normalization for comfortable late-night viewing (night mode)",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/enable_night_mode_audio/setup_task.sh",
    "post_task": "/workspace/tasks/enable_night_mode_audio/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_night_mode_audio"
    }
  },
  "metadata": {
    "difficulty": "medium",
    "category": "audio_effects",
    "skills": [
      "audio_effects_configuration",
      "dynamic_range_compression",
      "audio_normalization",
      "preferences_management",
      "persistent_settings"
    ],
    "real_world_scenario": "apartment_late_night_viewing"
  }
}