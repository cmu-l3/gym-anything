{
  "id": "configure_sleep_timer@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC to play for exactly 45 minutes and then automatically quit (sleep timer)",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_sleep_timer/setup_task.sh",
    "post_task": "/workspace/tasks/configure_sleep_timer/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_sleep_timer"
    }
  }
}