{
  "id": "frame_step_analysis@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Use frame-by-frame navigation to find and capture a specific visual marker in a tutorial video",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 120,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/frame_step_analysis/setup_task.sh",
    "post_task": "/workspace/tasks/frame_step_analysis/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_frame_step_analysis"
    }
  }
}