{
  "id": "convert_video@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Convert a video file from one format to another using VLC's conversion feature",
  "difficulty": "medium+",
  "init": {
    "timeout_sec": 120,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/convert_video/setup_task.sh",
    "post_task": "/workspace/tasks/convert_video/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_convert_video"
    }
  }
}
