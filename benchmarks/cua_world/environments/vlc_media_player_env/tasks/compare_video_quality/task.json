{
  "id": "compare_video_quality@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Open two video files simultaneously, seek to same timestamp, and capture side-by-side screenshots for quality comparison",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 240,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/compare_video_quality/setup_task.sh",
    "post_task": "/workspace/tasks/compare_video_quality/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_compare_video_quality"
    }
  }
}