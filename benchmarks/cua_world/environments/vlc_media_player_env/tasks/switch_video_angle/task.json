{
  "id": "switch_video_angle@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Switch between multiple video tracks (camera angles) in a multi-angle concert recording",
  "difficulty": "medium",
  "tags": ["vlc", "multi-track", "video-tracks", "navigation", "concert", "camera-angles"],
  "init": {
    "timeout_sec": 90,
    "max_steps": 35,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/switch_video_angle/setup_task.sh",
    "post_task": "/workspace/tasks/switch_video_angle/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_switch_video_angle"
    }
  }
}