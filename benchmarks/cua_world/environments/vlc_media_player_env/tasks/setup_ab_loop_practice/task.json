{
  "id": "setup_ab_loop_practice@1",
  "version": "1.0",
  "env_id": "vlc_env@0.1",
  "description": "Configure VLC A-B repeat loop for a specific dialogue segment (42-49s) to enable hands-free practice",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 60,
    "max_steps": 25,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/setup_ab_loop_practice/setup_task.sh",
    "post_task": "/workspace/tasks/setup_ab_loop_practice/export_result.sh"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_ab_loop_setup"
    }
  }
}