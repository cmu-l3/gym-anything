{
  "id": "add_wifi_text_badge@1",
  "version": "1.0",
  "env_id": "jolly_lobby_track_env@0.1",
  "description": "Modify the visitor badge template in Jolly Lobby Track to include Wi-Fi connection details. Open the Badge Designer (via Design or Configuration menu), select the default 'Visitor' template, and add a static text object to the bottom of the badge with exactly this text: 'Wi-Fi: GuestNet | Pass: Visitor2025'. Save the template changes.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/add_wifi_text_badge/setup_task.sh",
    "post_task": "/workspace/tasks/add_wifi_text_badge/export_result.sh"
  },
  "metadata": {
    "expected_ssid": "GuestNet",
    "expected_pass": "Visitor2025",
    "required_text": "Wi-Fi: GuestNet | Pass: Visitor2025",
    "search_paths": [
      "/home/ga/.wine/drive_c/ProgramData/Jolly Technologies",
      "/home/ga/.wine/drive_c/users/Public/Documents/Jolly Technologies",
      "/home/ga/.wine/drive_c/Program Files/Jolly Technologies"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_add_wifi_text_badge"
    }
  }
