{
  "id": "vendor_department_access_report@1",
  "version": "1.0",
  "env_id": "jolly_lobby_track_env@0.1",
  "description": "You are the Procurement Manager at ACME Corp conducting the annual vendor access review. Analyze all vendor visits to ACME Corp during December 2025. Group the vendor visits by host department, identify which department received the most vendor access, and produce a summary report. Export the complete vendor-by-department analysis to /home/ga/Desktop/vendor_dept_access_dec2025.csv. The report should include department names, vendor companies, and visit counts.",
  "difficulty": "very_hard",
  "init": {
    "timeout_sec": 600,
    "max_steps": 80,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/vendor_department_access_report/setup_task.sh",
    "post_task": "/workspace/tasks/vendor_department_access_report/export_result.sh"
  },
  "metadata": {
    "target_month": "December 2025",
    "badge_type_filter": "Vendor",
    "total_vendors_dec2025": 12,
    "top_department": "Facilities",
    "top_department_count": 3,
    "top_dept_vendors": ["Ford Motor Company", "Caterpillar Inc", "Honeywell International"],
    "all_departments": {
      "Facilities": 3,
      "Procurement": 2,
      "Logistics": 2,
      "Compliance": 1,
      "Legal": 1,
      "R&D": 1,
      "Health & Safety": 1,
      "Supply Chain": 1
    },
    "output_file": "/home/ga/Desktop/vendor_dept_access_dec2025.csv"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_vendor_department_access_report"
    }
  }
}
