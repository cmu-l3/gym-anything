{
  "id": "configure_admin_password@1",
  "version": "1.0",
  "env_id": "jolly_lobby_track_env@0.1",
  "description": "Configure the security settings for Lobby Track to protect the application. Navigate to the administration or program options, enable password protection, and set the Administrator password to 'LobbySecure2024!'. Ensure the setting is saved/applied. The application is currently unsecured.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_admin_password/setup_task.sh",
    "post_task": "/workspace/tasks/configure_admin_password/export_result.sh"
  },
  "metadata": {
    "expected_password": "LobbySecure2024!",
    "wine_prefix": "/home/ga/.wine",
    "app_data_path": "/home/ga/.wine/drive_c/users/ga/Application Data/Jolly Technologies",
    "program_data_path": "/home/ga/.wine/drive_c/ProgramData/Jolly Technologies"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_admin_password"
    }
  }
}