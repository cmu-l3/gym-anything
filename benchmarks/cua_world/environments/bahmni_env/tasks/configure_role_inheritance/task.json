{
  "id": "configure_role_inheritance@1",
  "version": "1.0",
  "env_id": "bahmni_env@0.1",
  "description": "Configure the existing security role 'Trainee' to inherit from the 'Provider' role. Navigate to the OpenMRS Administration interface, manage roles, and edit the 'Trainee' role to add 'Provider' to its Inherited Roles list.",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 50,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/configure_role_inheritance/setup_task.sh",
    "post_task": "/workspace/tasks/configure_role_inheritance/export_result.sh",
    "pre_task_timeout": 600
  },
  "metadata": {
    "target_role": "Trainee",
    "inherited_role": "Provider"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_configure_role_inheritance"
    }
  }
}