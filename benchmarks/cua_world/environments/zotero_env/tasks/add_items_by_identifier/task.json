{
  "id": "add_items_by_identifier@1",
  "version": "1.0",
  "env_id": "zotero_env@0.1",
  "description": "Add three academic papers to your Zotero library using the 'Add Item by Identifier' feature (the magic wand icon in the toolbar). Use the following DOIs:\n\n1. 10.1162/neco.1997.9.8.1735\n2. 10.1126/science.1127647\n3. 10.1109/5.726791\n\nThe task is complete when all three papers appear in your library with their correct metadata (titles, authors, etc.).",
  "difficulty": "medium",
  "init": {
    "timeout_sec": 300,
    "max_steps": 40,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/workspace/tasks/add_items_by_identifier/setup_task.sh",
    "post_task": "/workspace/tasks/add_items_by_identifier/export_result.sh"
  },
  "metadata": {
    "targets": [
      {
        "key": "lstm",
        "doi": "10.1162/neco.1997.9.8.1735",
        "title_keywords": ["Long Short-Term Memory"],
        "authors": ["Hochreiter", "Schmidhuber"]
      },
      {
        "key": "autoencoder",
        "doi": "10.1126/science.1127647",
        "title_keywords": ["Reducing the Dimensionality", "Neural Networks"],
        "authors": ["Hinton", "Salakhutdinov"]
      },
      {
        "key": "lenet",
        "doi": "10.1109/5.726791",
        "title_keywords": ["Gradient-Based Learning", "Document Recognition"],
        "authors": ["LeCun", "Bottou", "Bengio"]
      }
    ],
    "expected_delta": 3
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_add_items_by_identifier"
    }
  }
}