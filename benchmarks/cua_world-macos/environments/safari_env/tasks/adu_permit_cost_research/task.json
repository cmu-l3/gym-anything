{
  "id": "adu_permit_cost_research@1",
  "version": "1.0",
  "env_id": "safari_env@0.1",
  "description": "You own a home in Willow Glen, San Jose CA (ZIP 95125) and plan to build a 400-450 sq ft detached ADU for your wheelchair-using mother. Research San Jose permit requirements (setbacks, max sqft, height, owner-occupancy rule, ADA/Title 24 accessibility notes, permit fee estimate), at least 3 cost estimates by ADU type (site-built, prefab, JADU) with cost ranges per sqft, at least 3 local San Jose area contractors with ADU and accessibility experience, and at least 2 financing options (CalHFA ADU Grant, HELOC, construction loan). Save your research as a new Apple Notes note.",
  "difficulty": "very_hard",
  "init": {
    "timeout_sec": 1500,
    "max_steps": 150
  },
  "hooks": {
    "pre_task": "/Users/lume/workspace/tasks/adu_permit_cost_research/setup_task.sh",
    "post_task": "/Users/lume/workspace/tasks/adu_permit_cost_research/export_result.sh"
  },
  "metadata": {
    "output_app": "Apple Notes",
    "result_file": "/tmp/adu_permit_cost_research_result.json",
    "note_keywords": ["permit", "adu", "setback", "contractor", "financing", "sqft", "accessible", "san jose"],
    "note_length_partial_chars": 500,
    "note_length_full_chars": 2000,
    "note_keywords_partial": 2,
    "note_keywords_full": 5,
    "location": "Willow Glen, San Jose CA 95125",
    "adu_size_sqft_target": 425,
    "adu_type": "detached",
    "special_requirement": "wheelchair accessible / ADA",
    "min_cost_estimates": 3,
    "min_contractors": 3,
    "min_financing_options": 2,
    "source_domains_permit": [
      "sanjoseca.gov", "accelaaca.sanjoseca.gov", "abag.ca.gov",
      "hcd.ca.gov", "leginfo.legislature.ca.gov", "planning.ca.gov"
    ],
    "source_domains_contractor_cost": [
      "cslb.ca.gov", "houzz.com", "thumbtack.com", "yelp.com",
      "adublueprint.com", "casita.com", "buildinganadu.com"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_adu_permit_cost_research"
    }
  }
}
