{
  "id": "glp1_treatment_research@1",
  "version": "1.0",
  "env_id": "safari_env@0.1",
  "description": "Your doctor told you that you qualify for a GLP-1 receptor agonist for type 2 diabetes and weight management. She mentioned Ozempic, Mounjaro, and Wegovy. You have a follow-up in two weeks. Research how each drug works, key clinical trial results (weight loss, HbA1c, cardiovascular outcomes), side effects, insurance coverage, out-of-pocket costs with and without savings cards, and administration method. Save your findings as a new Apple Notes note to bring to your appointment.",
  "difficulty": "very_hard",
  "init": {
    "timeout_sec": 1200,
    "max_steps": 120
  },
  "hooks": {
    "pre_task": "/Users/lume/workspace/tasks/glp1_treatment_research/setup_task.sh",
    "post_task": "/Users/lume/workspace/tasks/glp1_treatment_research/export_result.sh"
  },
  "metadata": {
    "output_app": "Apple Notes",
    "result_file": "/tmp/glp1_treatment_research_result.json",
    "note_keywords": ["ozempic", "semaglutide", "trial", "weight", "coverage", "insulin", "cardiovascular", "diabetes", "side"],
    "note_length_partial_chars": 500,
    "note_length_full_chars": 2000,
    "note_keywords_partial": 2,
    "note_keywords_full": 5,
    "target_drugs": ["Ozempic", "Mounjaro", "Wegovy"],
    "source_domains_clinical": [
      "drugs.com", "mayoclinic.org", "medlineplus.gov",
      "ncbi.nlm.nih.gov", "nejm.org", "diabetes.org", "fda.gov"
    ],
    "source_domains_cost": [
      "goodrx.com", "needymeds.org", "rxsaver.com",
      "costplusdrugs.com", "blink health.com"
    ]
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_glp1_treatment_research"
    }
  }
}
