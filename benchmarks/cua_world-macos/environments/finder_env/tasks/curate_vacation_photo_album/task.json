{
  "id": "curate_vacation_photo_album@1",
  "version": "1.0",
  "env_id": "finder_env@0.1",
  "description": "Your Downloads folder has 24 vacation photos from three trips. Organize them into ~/Pictures/Family Trips/ with one subfolder per trip (Grand Canyon 2019, Pacific Coast 2021, New England 2023). In each trip folder create a Highlights subfolder containing the 3 most recent photos from that trip (determined by the date in the filename). Tag each trip folder with a color: Blue for Grand Canyon, Green for Pacific Coast, Red for New England. Add a Finder comment to each trip folder naming the destination and its month and year.",
  "difficulty": "very_hard",
  "tags": ["finder", "photos", "file-management", "tags", "organization", "macos"],
  "init": {
    "timeout_sec": 720,
    "max_steps": 90,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/Users/lume/workspace/tasks/curate_vacation_photo_album/setup_task.sh",
    "post_task": "/Users/lume/workspace/tasks/curate_vacation_photo_album/export_result.sh",
    "pre_task_timeout": 60
  },
  "metadata": {
    "pass_threshold": 70,
    "scenario": "personal_photo_organization",
    "archetype": "stateful_pipeline",
    "hardness_levers": ["multi_stage_decisions", "output_artifact_integrity", "personal_preferences"],
    "trips": {
      "Grand Canyon 2019": {
        "tag": "Blue",
        "highlight_files": ["2019-07-17_IMG_0256.jpg", "2019-07-19_IMG_0312.jpg", "2019-07-20_IMG_0389.jpg"]
      },
      "Pacific Coast 2021": {
        "tag": "Green",
        "highlight_files": ["2021-04-08_IMG_1222.jpg", "2021-04-09_IMG_1267.jpg", "2021-04-10_IMG_1311.jpg"]
      },
      "New England 2023": {
        "tag": "Red",
        "highlight_files": ["2023-08-25_IMG_2227.jpg", "2023-08-26_IMG_2271.jpg", "2023-08-28_IMG_2316.jpg"]
      }
    }
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_curate_vacation_photo_album"
    }
  }
}
