{
  "id": "organize_downloads_by_type@1",
  "version": "1.0",
  "env_id": "finder_env@0.1",
  "description": "Your ~/Downloads folder has 8 files that need to be organized. Create four subfolders inside ~/Downloads/ — Documents/, Images/, Archives/, and Other/ — then move every file into the correct subfolder using these categorization rules: PDF and TXT files go in Documents/; JPG and PNG files go in Images/; ZIP and .tar.gz files go in Archives/; M3U playlist files and GPX track files go in Other/. After completion, the root of ~/Downloads/ should contain only those four subdirectories — no loose files.",
  "difficulty": "hard",
  "tags": [
    "finder",
    "file-management",
    "organization",
    "file-manager",
    "macos"
  ],
  "init": {
    "timeout_sec": 600,
    "max_steps": 80,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/Users/lume/workspace/tasks/organize_downloads_by_type/setup_task.sh",
    "post_task": "/Users/lume/workspace/tasks/organize_downloads_by_type/export_result.sh",
    "pre_task_timeout": 60
  },
  "metadata": {
    "expected_folders": ["Documents", "Images", "Archives", "Other"],
    "expected_placement": {
      "Documents": ["reading_list.pdf", "meeting_notes.txt"],
      "Images": ["wallpaper.jpg", "screenshot.png"],
      "Archives": ["backup.zip", "data.tar.gz"],
      "Other": ["playlist.m3u", "route_planning.gpx"]
    },
    "categorization_rules": {
      "Documents": [".pdf", ".txt"],
      "Images": [".jpg", ".png"],
      "Archives": [".zip", ".tar.gz"],
      "Other": [".m3u", ".gpx"]
    },
    "pass_threshold": 80
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_organize_downloads_by_type"
    }
  }
}
