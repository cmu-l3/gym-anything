{
  "id": "archive_completed_projects@1",
  "version": "1.0",
  "env_id": "finder_env@0.1",
  "description": "Your ~/Documents/Projects/ folder has five personal projects. Some are marked done (they contain a file called DONE.txt inside) and some are still active. For each done project: apply a Red Finder tag to its folder, compress it into a zip file, move the zip to ~/Documents/Archive/, delete the original project folder, and add the Finder comment 'Archived May 2026' to the zip file. For each active project: apply a Green Finder tag to its folder and leave it in place.",
  "difficulty": "very_hard",
  "tags": ["finder", "file-management", "tags", "zip", "organization", "macos"],
  "init": {
    "timeout_sec": 760,
    "max_steps": 95,
    "reward_type": "sparse"
  },
  "hooks": {
    "pre_task": "/Users/lume/workspace/tasks/archive_completed_projects/setup_task.sh",
    "post_task": "/Users/lume/workspace/tasks/archive_completed_projects/export_result.sh",
    "pre_task_timeout": 60
  },
  "metadata": {
    "pass_threshold": 70,
    "scenario": "personal_project_housekeeping",
    "archetype": "audit_and_annotate",
    "hardness_levers": ["multi_stage_decisions", "output_artifact_integrity", "personal_preferences"],
    "active_projects": ["HomeRenovation", "LearnPiano"],
    "done_projects": ["VegetableGarden", "BookClub2024", "CookingChallenge"],
    "active_tag": "Green",
    "done_tag": "Red",
    "archive_dir": "~/Documents/Archive",
    "zip_comment": "Archived May 2026"
  },
  "success": {
    "mode": "program",
    "spec": {
      "program": "verifier.py::verify_archive_completed_projects"
    }
  }
}
