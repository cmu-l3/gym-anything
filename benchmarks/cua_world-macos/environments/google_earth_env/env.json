{
  "id": "google_earth_env@0.1",
  "version": "0.1",
  "base": "macos",
  "description": "Google Earth Pro on macOS via a use.computer remote sandbox. Free since 2015 (no license). Installed at /Applications/Google Earth Pro.app. Tasks cover basic navigation and visual confirmation that the globe renders.",
  "category": ["geography", "gis"],
  "resources": {
    "cpu": 4,
    "mem_gb": 8,
    "gpu": 0,
    "net": true
  },
  "observation": [
    {
      "type": "rgb_screen",
      "fps": 5,
      "resolution": [1920, 1080],
      "inline": false
    },
    {
      "type": "ui_tree"
    }
  ],
  "action": [
    {"type": "mouse"},
    {"type": "keyboard"}
  ],
  "synchronous": true,
  "step_cycle_ms": 200,
  "recording": {
    "enable": false,
    "output_dir": "benchmarks/cua_world-macos/environments/google_earth_env/artifacts"
  },
  "mounts": [
    {
      "source": "benchmarks/cua_world-macos/environments/google_earth_env/scripts",
      "target": "/Users/lume/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "benchmarks/cua_world-macos/environments/google_earth_env/tasks",
      "target": "/Users/lume/workspace/tasks",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "/Users/lume/workspace/scripts/install_google_earth.sh",
    "post_start": "/Users/lume/workspace/scripts/setup_google_earth.sh"
  },
  "tags": [
    "macos",
    "google-earth",
    "gis",
    "geography",
    "use_computer",
    "remote"
  ]
}
